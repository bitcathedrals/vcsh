#
# gitconfig for Mr. Mattie
#

[user]
	name = Michael Mattie
	email = codermattie@runbox.com
	signingkey = 0x5428B78471A9A634!

[core]
	trustExitCode = true

[commit]
#	gpgsign = true

[init]
	defaultBranch = main

[pull]
	rebase = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
  editor = run-emacs
	ignoreSubmodules = dirty

[diff]
	tool = emacs

[merge]
	tool = emacs

[difftool "emacs"]
  cmd = run-emacs -e "(grail-diff-elisp \"$LOCAL\" \"$REMOTE\")"

[mergetool "emacs"]
 	cmd = 'run-emacs' "+" "$LOCAL" "$REMOTE" "$MERGED"

