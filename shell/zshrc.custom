function set_macos_path_helper {
  # this sets up macos path from /etc/path.d plus manpages
  helper=/usr/libexec/path_helper

  if [[ -x $helper ]]
  then
    eval "$($helper)"
  fi
}

function set_homebrew {
  # brew can be in three different locations

  for brew_binary in "/opt/homebrew/bin/brew" "/usr/local/bin/brew" "$HOME/homebrew/bin/brew" 
  do
    if [[ -e $brew_binary ]]
    then
      eval $($brew_binary shellenv)
      return 0
    fi
  done

  # try a path search

  if command -v brew >/dev/null 2>&1
  then
    brew_binary=`which brew`
    eval $($brew_binary shellenv)

    return 0
  fi

  return 1
}

function unique_path {
  reversed_list=$(echo $PATH | /usr/bin/tr -s ":" | /usr/bin/tr ":" "\n" | sort -r | sed '/^$/d')

  final=""

  for path in $(echo $reversed_list)
  do
    removed=$(echo $removed | /usr/bin/tail -n +1)

    if ! echo "$removed" | /usr/bin/grep $path - >/dev/null 2>&1
    then
      final="${path}\n${final}"
    fi
  done

  user_paths=$(echo "$final" | /usr/bin/grep -E '^/home')
  user_paths=$(echo "$user_paths" | /usr/bin/awk '{ temp=$0 ; print gsub(/\//, "", temp) " " $0 }' - | /usr/bin/sort -r -n -k1,1 | /usr/bin/cut -d' ' -f2-)
  user_paths=$(echo "$user_paths"  | /usr/bin/tr "\n" ":")

  system_paths=$(echo "$final" | /usr/bin/grep -v -E '^/home')
  system_paths=$(echo "$system_paths" | /usr/bin/awk '{ temp=$0 ; print gsub(/\//, "", temp) " " $0 }' - | /usr/bin/sort -r -n -k1,1 | /usr/bin/cut -d' ' -f2-)
  system_paths=$(echo "$system_paths" | /usr/bin/tr "\n" ":")

  PATH=$(echo "${user_paths}:${system_paths}" | /usr/bin/tr -s ":")
  export PATH
}

function set_editor {
  if [[ -x $EDITOR ]]
  then
    return 0
  fi

  if command -v run-emacs >/dev/null 2>&1
  then
    export EDITOR=run-emacs
    return 0
  fi

  if command -v emacsclient >/dev/null 2>&1
  then
    export EDITOR=emacsclient
    return 0
  fi

  if command -v nano >/dev/null 2>&1
  then
    export EDITOR=nano
    return 0
  fi

  echo >/dev/stderr "zshrc: (WARNING) no editor found!"
  return 1
}

function launch_ssh_agent {
  # this can be used for per OS handling of OS, disabled for now
  system=`uname`

  case "$system" in
    "Darwin")
        return
        ;;  
    "Linux")
        if [[ -f /etc/os-release ]]
        then
            source /etc/os-release
        
            if [[ "$NAME" == "Ubuntu" ]]
            then
                return
            fi
        fi
        ;;
  esac

  if [[ "$TERM" == "eterm-color" ]]
  then
    return
  fi

  if [[ -z $SSH_AGENT_PID ]]
  then
    echo "ssh-agent: no SSH_AGENT_PID env var - starting a new ssh-agent."
    eval $(ssh-agent -s)
    return
  fi

  echo -n "vcsh: found ssh-agent debris..."

  if pgrep -U $USER ssh-agent >/dev/null 2>&1
  then
    if kill -0 $SSH_AGENT_PID >/dev/null 2>&1
    then
      echo "live agent."
      return
    fi

    pkill -U $USER ssh-agent >/dev/nuill 2>&1
  fi

  echo >/dev/stderr "vcsh: dead agent(s). starting a new ssh-agent."
  eval $(ssh-agent -s)
}

function set_pyenv {
  command -v 'pyenv' >/dev/null 2>&1 || return 0

  TOOLS=$HOME/tools
  PYENV_ROOT="$TOOLS/pyenv"
  PATH="$TOOLS/local/bin:$PATH"
  PATH="$PYENV_ROOT/bin:$PATH"
  PATH="$PYENV_ROOT/libexec:$PATH"

  export PYENV_ROOT PATH

  eval "$(pyenv init -)"
}

# quiet pipenv about installing into existing virtualenvs.
export PIPENV_VERBOSITY=-1

set_macos_path_helper
set_homebrew
set_pyenv

if [[ `uname` == Darwin ]]
then
  binutils=""

  if [[ -d "/opt/homebrew" ]]
  then
    binutils=$(find "/opt/homebrew/Cellar/binutils" -name "*" -depth 1 -print 2>/dev/null | sort -V -t '/' -k 5)
  fi

  if [[ -d "${binutils}/bin" ]]
  then
    PATH="$PATH:${binutils}/bin"
  fi
fi

CODE=$HOME/code

PATH="$CODE/utilities/bin:$PATH"
PATH="$CODE/security/bin:$PATH"
PATH="$CODE/pythonsh/bin:$PATH"
PATH="$CODE/docker/bin:$PATH"
PATH="$CODE/grail/bin:$PATH"
PATH="$CODE/cppsh/bin:$PATH"
PATH="$CODE/vcsh/bin:$PATH"

unique_path

set_editor

# this can be used for per OS handling of OS, disabled for now
system=`uname`

launch_ssh_agent

# if there is a file for crypto keys then add it
if [[ -f $HOME/.crypto.sh ]]
then
  source $HOME/.crypto.sh
fi

export ZSHRC_CUSTOM_LOADED="yes"
