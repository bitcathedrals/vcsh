#! /usr/bin/env bash

# this will put us in bin/
VCSH=$(dirname $0)
# this will put is in the vcsh base directory
VCSH_BASE=$(dirname "$VCSH")

VCSH_SHELL="${VCSH_BASE}/shell/"

VCSH_BREW=""

VCSH_SYSTEM=$(uname)

EMACS_BREW="/opt/emacs/"
DEP_BREW="/opt/dependencies/"

case $VCSH_SYSTEM in
  "Darwin")
    VCSH_BREW="/opt/dependencies"

    if which arch >/dev/null 2>&1
    then
      VCSH_ARCH=$(arch)

      if [[ $VCSH_ARCH == "arm64" ]]
      then
        VCSH_ARCH_COMMAND="arch -arm64"
      fi
    fi
  ;;
esac

#
# default values
#

MAIN="main"
INTEGRATION="develop"
FEATURE="feature"
BUGFIX="bugfix"
RELEASE="release"
TAG="release"
VERSION=""

DATE_ARG="--date="
DATE_DEFAULT="relative"

VERBOSITY='no'

#
# vc.sh, required and overrides
#

test -f vc.sh && source vc.sh

DATE="${DATE_ARG}${DATE:-$DATE_DEFAULT}"

#
# verbosity - print information to stderr if VERBOSE = 'yes'
#

# task         = the task at hand
# description  = description of what is being performed
# @            = information for the user

function verbosity {
  if [[ $VERBOSE == 'no' ]]
  then
    return
  fi

  task=$1
  shift

  describe=$1
  shift

  info=""

  if [[ $# -gt 0 ]]
  then
    info="> $*"
  fi

  echo >/dev/stderr "vc: [${task}] $describe $info"
}

#
# error - produce a formatted error message but do
#         not exit
#

# task        = the task that failed
# status      = the exit status of the command that failed
# description = description of the task that failed

function error {
  task=$1
  shift

  status=$1
  shift

  describe=$1
  shift

  echo >/dev/stderr "vc: [${task}] error! (${status}) ${describe} > $*"
}

#
# abort - print error information and exit 1
#

# task          = the task that failed
# description   = description of what failed
# status        = the exit status of the command that failed

function abort {
  task=$1
  shift

  describe=$1
  shift

  exit_code=""

  if [[ $# -gt 0 ]]
  then
    exit_code=$1
  fi
  shift

  if [[ -n $exit_code ]]
  then
    exit_code="(${exit_code})"
  fi

  echo >/dev/stderr "vc: [${task}] abort! $exit_code $describe > \"$*\""
  exit 1
}

#
# try - try to execute a command with verbosity and error calls
#       baked in.
#

# command     = command to execute
# task        = the task at hand
# description = describe what is being done
# @           = remaining args are passed to command

# RETURN      = status of command
function try {
  command=$1
  shift

  task=$1
  shift

  describe=$1
  shift

  verbosity "$task" "$describe" "$command" $@

  if [[ "$DRY"='yes' ]]
  then
    echo >/dev/stderr "vc noexec: $command $*" 
    return 0
  fi

  exit_status=""

  $command $@
  
  exit_status=$?

  if [[ $exit_status -gt 0 ]]
  then
    error "$task" "$command $status" "$describe" $@
  fi

  return $exit_status
}


function root_to_branch {
  branch=$(git branch | grep '*' | cut -d ' ' -f 2)

  if [[ $branch == "develop" ]]
  then
    if [[ $1 == "norelease" ]]
    then
      root="main"
    else
      root=$(git tag | grep release | sort -V | tail -n 1)
    fi
  else
    root='develop'
  fi
}

function create_tag {
  TYPE=$1

  FEATURE=$2

  if [[ -z $FEATURE ]]
  then
    echo >/dev/stderr "tag-${TYPE} requires the feature as the first argument"
  fi

  MESSAGE=$3

  if [[ -z $MESSAGE ]]
  then
    echo >/dev/stderr "tag-${TYPE} requires description as the second argument"
  fi

  if git tag | grep "${TYPE}-${USER}/${FEATURE}"
  then
    COUNT=$(git tag | grep "${TYPE}-${USER}/${FEATURE}" | wc -l)

    COUNT=$((COUNT + 1))

    TAG_NAME="${TYPE}-${USER}/${FEATURE}(${COUNT})"
  else
    TAG_NAME="${TYPE}-${USER}/${FEATURE}(1)"
  fi

  echo >/dev/stderr "tag name is: $TAG_NAME"

  read -p "create tag? [y/n]: " choice

  if [[ $choice == "y" ]]
  then
    git tag -a $TAG_NAME -m $MESSAGE
  else
    echo >/dev/stderr "tag-alpha: aborting!"
    exit 1
  fi
}

#
# git_options
#

# :custom          = <branch>...?<trunk> or <trunk>...?<branch>
# :upstream        = execute against upstream branch
# :no-merges       = do not show merges
# :only-merges     = only show merges
# :merge           = use ... spec to show changes not in <trunk> and <branch>

# @                = files to operate on, only a single file is legal git.

# DATE             = date format
# COLOR            = yes/no show in color
# SHOW             = flags for output type and format
# VC_ARGS          = remaining arguments from common option processing

#
# return STATUS    = 0 if succesful, 1 if there was an error
#

# 

# pre_history[@]   = this array contains the options that follow
#                    a git command, but before inserted options
#                    and post_history
# post_history[@]  = this array contains the options that are
#                    at the end of a git command.
function git_options {
  merges='false'
  upstream="false"

  spec=""

  type="changes"

  if [[ -n $CUSTOM ]]
  then
    type="custom"
  fi

  while [[ $# -gt 0 ]]
  do
    if [[ "$1" == ":custom" ]]
    then
      type="custom"
      shift

      spec=$1
      shift

      if [[ -z $spec ]]
      then
        abort "git_options" ":custom spec was missing"
      fi

      continue
    fi

    if [[ "$1" == ":upstream" ]]
    then
      upstream='true'
      shift
      continue
    fi

    if [[ "$1" == ":no-merges" ]]
    then
      merge_flags=("--first-parent")
      shift
      continue
    fi

    if [[ "$1" == ":only-merges" ]]
    then
      merging='true'
      merge_flags=("--merges")
      shift
      continue
    fi

    if [[ "$1" == ":merge" ]]
    then
      merging='true'
      shift
      continue
    fi
  done

  if [[ ${#VC_ARGS[@]} -gt 0 ]]
  then
    for f in ${VC_ARGS[@]}
    do
      if [[ ! -f $f ]]
      then
        abort "git_options" "processing unrecognized arguments" "NA" "file \"$f\" does not exist"
      fi
    done
  fi

  case $type in
    "changes")
      if [[ "$upstream" == 'true' ]]
      then
        spec="HEAD..@{upstream}"
      else
        root_to_branch
        spec="${root}..${branch}"
      fi
    ;;
    "merging")
      if [[ "$upstream" == 'true' ]]
      then
        spec="HEAD...@{upstream}"
      else
        root_to_branch
        spec="${root}...${branch}"
      fi
    ;;
    "custom")
      spec=$CUSTOM
    ;;
    *)
      error "git_options" "NA" "log type not specified"
      exit 1
    ;;
  esac


  case $COLOR in
    "yes")
      COLOR="--color"
    ;;
    "no")
      COLOR=""
    ;;
  esac

  OP="log"

  if [[ "$DIFF" == 'yes' ]]
  then
    OP="diff"
  fi

  if [[ "$TOOL" == 'yes' ]]
  then
    OP="difftool"
  fi

  pre_history=($OP $DATE $COLOR $merge_flags)

  post_history=($SHOW $STAT $spec)

  if [[ ${#files[@]} -gt 0 ]]
  then
    post_history+=(${post_history[@]} "--follow" "--" ${files[@]})
  fi

  verbosity "git_options" "generated options" ${pre_history[@]} ${post_history[@]}

  return 0
}

#
# vc_git_common_args - process CLI arguments for git_options
#

# -compact      = show oneline compact form
# -stat         = show diffstat output
# -graph        = show graph of commit history
# -details      = show branch details in log output
# -decorate     = decorate history with branch information
# -color        = color history output
# -no-color     = don't color history output
# -v            = verbose
# -diff         = use a diff operation
# -emacs        = use emacs as a difftool or mergetool
# return

# SHOW          = git flag to specify output type
# STAT          = git 
# DIFF          = yes if showing diff instead of logs
# COLOR         = yes to color output
# VERBOSE       = yes/no to enable verbosity
# CUSTOM        = a custom commit or range specification
function vc_git_common_args {
  VC_ARGS=()

  SHOW=""
  STAT=""
  DIFF="no"
  TOOL="no"
  CUSTOM=""

  while [[ $# -gt 0 ]]
  do
    if [[ "$1" == "-v" ]]
    then
      VERBOSE='yes'
      shift
      continue
    fi

    if [[ "$1" == "-stat" ]]
    then
      STAT="--stat"
      shift
      continue
    fi

    if [[ "$1" == "-color" ]]
    then
      COLOR='yes'
      shift
      continue
    fi

    if [[ "$1" == "-no-color" ]]
    then
      COLOR='no'
      shift
      continue
    fi

    if [[ "$1" == "-diff" ]]
    then
      DIFF='yes'
      shift
      continue
    fi

    if [[ "$1" == "-tool" ]]
    then
      TOOL='yes'
      shift
      continue
    fi

    if [[ "$1" == "-compact" ]]
    then
      SHOW="--oneline"
      shift
      continue
    fi

    if [[ "$1" == "-details" ]]
    then
      SHOW="--pretty=fuller"
      shift
      continue
    fi

    if [[ "$1" == "-graph" ]]
    then
      SHOW="--graph"
      shift
      continue
    fi

    if [[ -z $CUSTOM ]]
    then
      CUSTOM=$1
      shift
      continue
    fi

    VC_ARGS+=$1
    shift
  done
}

#
# semantic_commits
#

# type   = release|main = return commits by "type" against either release->main or main->integration
# filter = semantic tag to filter by

function semantic_commits {
  type="current"

  if [[ -n $1 ]]
  then
    type=$1
  fi

  spec=""

  case $type in
    "release")
      last=`git tag | grep "${RELEASE}" | sort -V | tail -n 1`

      if [[ -z $last ]]
      then
        abort "get_semantic_commits" "no release tags"
      fi

      spec="${last}..${MAIN}"
    ;;
    "integrate")
      spec="${MAIN}..${INTEGRATION}"
    ;;
  esac

  vc_git_common_args -compact -no-color

  if [[ -n $spec ]]
  then
    git_options :no-merges :custom "$spec"
  else
    git_options :no-merges
  fi

  try "git" "semantic_commits" log ${pre_history[@]} ${post_history[@]} | read -r REPORT
}

function get_semantics {
  filter=$1;

  if [[ -n $REPORT ]]
  then
    echo "$REPORT" | cut -d ' ' -f 2-
  fi
}

function print_report {
  if [[ -n $features ]]
  then
    cat <<MESSAGE

* features

$features
MESSAGE
  fi

  if [[ -n $bugs ]]
  then
    cat <<MESSAGE

* bugs

$bugs
MESSAGE
  fi

  if [[ -n $fixes ]]
  then
    cat <<MESSAGE

* fixes

$fixes
MESSAGE
  fi

  if [[ -n $syncs ]]
  then
    cat <<MESSAGE

* syncs

$syncs
MESSAGE
  fi

  if [[ -n $refactor ]]
  then
    cat <<MESSAGE

* refactor

$refactor
MESSAGE
  fi
}

case $1 in
  "tools-zshrc")
    cp "${VCSH_SHELL}/zshrc.rc" $HOME/.zshrc
    echo >/dev/stderr >/dev/stderr "vcsh: replaced .zshrc with upstream version"
    ;;
  "tools-custom")
    cp "${VCSH_SHELL}/zshrc.custom" $HOME/.zshrc.custom
    echo >/dev/stderr "vcsh: replaced .zshrc.custom with upstream version"
    ;;
  "tools-prompt")
    cp "${VCSH_SHELL}/zshrc.prompt" $HOME/.zshrc.prompt
    echo >/dev/stderr "vcsh: installed prompt with pyenv and github support"
    ;;

  "tools-brew-init")
    test -d /opt/homebrew || sudo mkdir -p /opt/homebrew
    curl -L https://github.com/Homebrew/brew/tarball/master >/tmp/brew.xz
    sudo tar xJf /tmp/brew.xz --strip 1 -C /opt/homebrew
    sudo chown -R mattie /opt/homebrew
    ;;

  "tools-brew-upgrade")
     $VCSH_ARCH_COMMAND brew update
     $VCSH_ARCH_COMMAND brew upgrade
  ;;
  "tools-brew-install")
    shift

    $VCSH_ARCH_COMMAND brew install $@
  ;;
  "tools-brew-rebuild")
    $VCSH_ARCH_COMMAND brew list | xargs arch -arm64 brew reinstall
  ;;
  "dependencies-init")
    test -d /opt/dependencies || sudo mkdir -p /opt/dependencies
    curl -L https://github.com/Homebrew/brew/tarball/master >/tmp/brew.xz
    sudo tar xJf /tmp/brew.xz --strip 1 -C /opt/dependencies
    sudo chown -R mattie /opt/dependencies
  ;;

  "dependencies-upgrade")
    eval $(${DEP_BREW}bin/brew shellenv)

    $VCSH_ARCH_COMMAND brew update
    $VCSH_ARCH_COMMAND brew upgrade
  ;;

  "dependencies-install")
    shift

    eval $(${DEP_BREW}bin/brew shellenv)
    $VCSH_ARCH_COMMAND brew install $*
  ;;

  #
  # modules
  #
  "modinit")
    git submodule init
    git submodule update --init
    ;;
  "modadd")
    shift

    if [[ -z "$1" || -z "$2" || -z "$3" ]]
    then
      echo >/dev/stderr "vcsh: add submodule command requires <repo> <branch> <local>"
      exit 1
    fi

    if git submodule add -b $2 $1 $3
    then
      echo "vcsh: add ok. please remember to commit"
    else
      echo "vcsh: add failed. cleanup required."
      exit 1
    fi
    ;;
  "modsync")
    if git pull --recurse-submodules
    then
      echo "vcsh: update ok. please remember to test and commit."
    else
      echo "vcsh: update failed. cleanup required."
      exit 1
    fi
    ;;
  "modupdate")
    shift

    if [[ -z $1 ]]
    then
      echo "vcsh: update a submodule requires a submodule path"
      exit 1
    fi

    if git submodule update --remote $1
    then
      echo "vcsh: update ok. please remember to test and commit."
    else
      echo "vcsh: update failed. cleanup required."
      exit 1
    fi
    ;;
  "modbranch")
    shift

    if [[ -z $1 || -z $2 ]]
    then
      echo "vcsh: update a submodule requires a submodule path and a branch"
      exit 1
    fi

    if (cd $1 && git checkout $2)
    then
      echo "vcsh: switch to branch $2 ok. please remember to commit."
    else
      echo "vcsh: switch submodule $1 to branch $2 failed. cleanup required."
    fi
    ;;
  "modrm")
    shift

    if git rm $1 && git rm -f $1
    then
      if [[ -d $1 ]]
      then
        rm -rf $1
        echo "manual cleanup of source tree $1 done."
      fi

      if [[ -d ".git/modules/$1" ]]
      then
        rm -rf ".git/modules/$1"
        echo "manual cleanup of git module $1 done."
      fi

      echo "vcsh: removal of $1 succeeded."
    else
      echo "vcsh: removal of $1 failed. Repo is in a unknown state"
    fi
    ;;
  "modall")
    echo "all submodule updating..."
    git submodule update --init --recursive || exit 1
    echo "all submodule update done."
    ;;
  #
  # feature branches
  #

  "begin")
    shift
    name=$1

    if [[ -z $name ]]
    then
      echo "vcsh begin: requires a name for a new feature branch as an argument"
      exit 1
    fi

    git checkout -b "${FEATURE}/${name}"

    if [[ $? -ne 0 ]]
    then
      echo >/dev/stderr "vcsh begin: error creating feature branch $name"
      exit 1
    fi

    echo >/dev/stderr "vcsh begin: on new feature branch \"$name\""
   ;;
  "end")
    shift
    name=$1

    if [[ -z $name ]]
    then
      abort "end" "get name of branch from arguments" "NA"
    fi

    if ! git branch | grep "${FEATURE}/${name}"
    then
      abort "end" "feature branch ${name} not found" "NA"
    fi

    if ! git checkout "${INTEGRATION}"
    then
      abort "end" "error swithing to ${INTEGRATION} branch for merging ${name}" "NA"
    fi
    ;;
  "features")
    git branch | grep "${FEATURE}"
    ;;

  "bug")
    shift
    name=$1

    if [[ -z $name ]]
    then
      echo "vcsh bug: requires a name for a new bug branch as an argument"
      exit 1
    fi

    git flow bugfix start "$name"
    ;;
  "close")
    shift
    name=$1

    if [[ -z $name ]]
    then
      echo "vcsh close: requires the name of the bugfix branch to close"
      exit 1
    fi

    git flow bugfix finish $name
    ;;

  "bugfixes")
    git branch | grep "${BUGFIX}"
    ;;    

  "goto")
    shift
    name=$1

    if [[ -z $name ]]
    then
      echo "vcsh goto: requires the name of the bug or feature branch as an argument"
      exit 1
    fi

    if [[ "$name" == "$INTEGRATON" || "$name" == "$MAIN" ]]
    then
      exec git checkout "$name"
    fi

    if git branch | grep "${FEATURE}/$name" >/dev/null 2>&1
    then
      echo "vc checking out feature: $name" >/dev/stderr
      exec git checkout "feature/${name}"
    fi

    if git branch bugfix | grep "$name" >/dev/null 2>&1
    then
      echo "vc checking out bugfix: $name" >/dev/stderr
      exec git checkout "bugfix/${name}"
    fi

    echo "vcsh goto: \"$name\" not found in features or bugfixes"
    exit 1
    ;;    
  "beta")
    shift

    FEATURE=$1

    if [[ -z $FEATURE ]]
    then
      echo >/dev/stderr "vcsh: tag-beta - a feature argument (1) is missing"
      exit 1
    fi

    MESSAGE=$2

    if [[ -z $MESSAGE ]]
    then
      echo >/dev/stderr "vcsh tag-beta - a messsage argument (2) is missing."
      exit 1
    fi

    create_tag "beta" "$FEATURE" "$MESSAGE"
    ;;
  "track")
    shift

    REMOTE=$1

    if [[ -z $REMOTE ]]
    then
      echo >/dev/stderr "vcsh: track - a remote (1) is missing"
      exit 1
    fi

    BRANCH=$2

    if [[ -z $BRANCH ]]
    then
      echo >/dev/stderr "vcsh track - a branch (2) is missing."
      exit 1
    fi

    git branch -u $REMOTE/$BRANCH
    ;;
  "report")
    shift

    type=""

    while [[ $# -gt 0 ]]
    do
      if [[ $1 == "-v" ]]
      then
        VERBOSE="yes"
        shift
        continue
      fi

      if [[ $1 == "-main" ]]
      then
        type="release"
        shift
        continue
      fi

      if [[ $1 == "-dev" ]]
      then
        type="integrate"
        shift
        continue
      fi

      abort "report" "unrecognized option: $1" "NA"
      shift
    done

    semantic_commits $type

#    features=`get_semantics feat`
#    bugs=`get_semantics bug`
#    issues=`get_semantics issue`
#    syncs=`get_semantics sync`
#    fixes=`get_semantics fix`
#    refactor=`get_semantics refactor`

    print_report
    ;;
  "info")
    git branch -vv

    echo "[untracked]"
    git ls-files -o --exclude-standard

    echo "[staged]"
    git diff --staged --stat

    echo "[changes]"
    git diff --stat
    ;;
  "verify")
    exec git log --show-signature $@
    ;;
  "since")
    shift

    from=$1
    shift

    exec git log --since "$from" $@
    ;;
  "status")
    git status | grep -v -E '^$'
    git diff --stat | grep -v -E '^$'
    ;;
  "fetch")
    git fetch
    git fetch origin ${MAIN}
    git fetch origin ${INTEGRATION}
    ;;
  "pull")
    git pull --no-ff
    ;;
  "staged")
    git diff --cached
    ;;
  "pending")
    shift

    vc_git_common_args $@

    git_options :merge

    try "git" "pending" 'show work not in root' ${pre_history[@]} ${post_history[@]} | grep -v -E '^$'
    exit $?
    ;;
  "merges")
    shift

    git_options ":only-merges" $@
    try "git" "merges" "log of merges only" ${pre_history[@]} ${post_history[@]} | grep -v -E '^$'
    ;;
  "releases")
    git tag | grep release | sort -V | grep -v -E '^$'
    ;;
  "history")
    shift

    vc_git_common_args $@

    git_options

    try "git" "history" "show commits on current branch" ${pre_history[@]} ${post_history[@]} | grep -v -E '^$'
    ;;
  "ahead")
    shift

    vc_git_common_args $@

    git_options $@

    try "git" "ahead" 'show commits in branch, not trunk' ${pre_history[@]} ${post_history[@]} | grep -v -E '^$'
    ;;
  "behind")
    shift

    vc_git_common_args $@

    root_to_branch norelease

    git_options

    try "git" "behind" "show commits on trunk not in branch" ${pre_history[@]} ${post_history[@]} | grep -v -E '^$'
    ;;
  "upload")
    git push origin "${MAIN}:${MAIN}"
    git push origin "${INTEGRATION}:${INTEGRATION}"

    git push --tags
    ;;
  "down")
    shift

    git fetch origin ${MAIN}
    git fetch origin ${INTEGRATION}

    vc_git_common_args $@
    git_options :upstream

    try "git" "down" "fetch and show commits upstream not local" ${pre_history[@]} ${post_history[@]} | grep -v -E '^$'
    ;;
  "sync")
    root_to_branch norelease

    echo ">>>syncing from: ${root}->${branch}"

    git merge --no-ff --stat ${root}
    ;;

  #
  # release environment
  #
  "check")
    verbosity "check" "fetching new commits from remote"
    git fetch origin develop

    echo "===> showing unmerged differences <===="

    verbosity "check" "showing unmerged differences"

    git log develop..origin/develop --oneline

    echo "===> checking if working tree is dirty <==="

    if git diff --quiet >/dev/null 2>&1
    then
      echo "working tree clean - proceed!"
    else
      echo "working tree dirty - DO NOT RELEASE"

      git status
      exit 1
    fi
    ;;
  "start")
    shift

    $0 check

    echo "EDITOR is: $EDITOR ... correct?"

    read -p "Proceed? [y/n]: " proceed

    if [[ $proceed = "y" ]]
    then
      echo ">>> proceeding with release start!"
    else
      echo ">>> ABORT! exiting now!"
      exit 1
    fi

    VERSION="$1"

    echo -n "initiating git flow release start with version: $VERSION"

    git flow release start $VERSION

    if [[ $? -ne 0 ]]
    then
      echo "git flow release start $VERSION FAILED!"
      exit 1
    fi

    echo -n ">>>please edit python.sh with an updated version in 3 seconds."
    sleep 1
    echo -n "."
    sleep 1
    echo -n "."
    sleep 1

    $EDITOR python.sh || exit 1
    git add python.sh

    echo ">>>re-loading vc.sh"
    source vc.sh

    echo ">>>commit with release notes for version $VERSION"

    # don't do a automatic commit so a release summary can be inserted
    git commit

    echo "ready for release finish: please finish with vc release once you are ready"
    ;;
  "release")
    git flow release finish $VERSION || exit 1
    ;;
  "upload")
    git push origin main:main
    git push origin develop:develop

    git push --tags
    ;;
  "help")
    if [[ -n $2 ]]
    then
      filter="$2"
    else
      filter='\.*'
    fi

    echo "filter is $filter"

    cat <<HELP | grep "$filter"
vc

[tools commands]

tools-python  = install pyen and pyenv virtual from source on UNIX (call again to update)

tools-zshrc   = install hombrew, pyenv, and pyenv switching commands into .zshrc
tools-custom  = install zshrc.custom
tools-prompt  = install prompt support with pyeenv, git, and project in the prompt

brew-upgrade  = upgrade brew packages

tools-brew-init     = initialize the /opt/homebrew homebrew repository
tools-brew-upgrade  = upgrade the /opt/homebrew repository
tools-brew-install  = install into /opt/homebrew a list of packages
tools-brew-rebuild  = rebuild packages in /opt/homebrew

dependencies-init     = initialize /opt/dependencies for stable and minimal deps to compile against
dependencies-upgrade  = upgrade /opt/dependencies 
dependencies-install  = install into /opt/dependencies a list of packages
dependencies-python   = install into /opt/dependencies python dependencies

[submodule]

modinit             = initialize and pull all submodules
modadd <1> <2> <3>  = add a submodule where 1=repo 2=branch 3=localDir (commit after)
modupdate <module>  = pull the latest version of the module
modsync             = pull and sync all modules to checked out commits
modrm  <submodule>  = delete a submodule
modall              = update all submodules

[version control]

begin    <name> = start feature branch <name>
end      <name> = close feature branch <name>
features        = list feature branches

bug      <name> = start a bug branch
close    <name> = finish a bugfix merging into develop
bugfixes <name> = list bugfix branches

goto     <name> = switch to feature or bugfix branch, searches branches

track <1> <2>  = set upstream tracking 1=remote 2=branch

beta       = <feat> <msg> = create a beta tag with the devel branch feature and message
info       = show branches, tracking, and status
verify     = show log with signatures for verification
status     = git state, submodule state, diffstat for changes in tree
since      = <DATE> pull logs since date, extra <ARGS...> are passed
fetch      = fetch main, develop, and current branch
pull       = pull current branch no ff

[show log/diff/reports]

staged     = show staged changes

merges     = show merges only
releases   = show releases (tags)
features   = show feature branches

history    = show commit history
pending    = commits not in root or branch
ahead      = show log of commits in branch but not in parent
behind     = show log of commit in parent but not branch

report     = [-release] = generate a report of changes since integration

up         = push up changes to remote
down       = pull down and show changes

sync       = merge from the root branch commits not in this branch no ff

[release]

check      = fetch main, develop from origin and show log of any pending changes
start      = initiate an EDITOR session to update VERSION in python.sh, reload config,
             snapshot Pipfile if present, and start a git flow release with VERSION

             for the first time pass version as an argument e.g: "vc start 1.0.0"

release    = execute git flow release finish with VERSION
upload     = push main and develop branches and tags to remote
HELP
  ;;
  *)
    $0 history $@
  ;;
esac

exit 0
