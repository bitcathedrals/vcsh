#! /usr/bin/env bash

# this will put us in bin/
VCSH=$(dirname $0)
# this will put is in the vcsh base directory
VCSH_BASE=$(dirname "$VCSH")

VCSH_SHELL="${VCSH_BASE}/shell/"

VCSH_BREW=""

VCSH_SYSTEM=$(uname)

EMACS_BREW="/opt/emacs/"
DEP_BREW="/opt/dependencies/"

case $VCSH_SYSTEM in
  "Darwin")
    VCSH_BREW="/opt/dependencies"

    if which arch >/dev/null 2>&1
    then
      VCSH_ARCH=$(arch)

      if [[ $VCSH_ARCH == "arm64" ]]
      then
        VCSH_ARCH_COMMAND="arch -arm64"
      fi
    fi
  ;;
esac

#
# default values
#

MAIN="main"
INTEGRATION="develop"
FEATURE="feature"
BUGFIX="bugfix"
RELEASE="release"
TAG="release"
VERSION=""

DATE_ARG="--date="
DATE_DEFAULT="relative"

VERBOSE='no'
DRY='no'
TRACE='no'

#
# vc.sh, required and overrides
#

VC_CONFIG="vc.sh"
dir=$PWD

while [[ ! -e "${dir}/$VC_CONFIG" ]]
do
  if [[ "$dir" == "$HOME" ]]
  then
    break
  fi

  if [[ -d "${dir}/.git" ]]
  then
    break
  fi

  dir=`dirname $dir`
done

test -e "${dir}/${VC_CONFIG}" && source "${dir}/${VC_CONFIG}"

DATE="${DATE_ARG}${DATE:-$DATE_DEFAULT}"

#
# verbosity - print information to stderr if VERBOSE = 'yes'
#

# task         = the task at hand
# description  = description of what is being performed
# @            = information for the user

function verbosity {
  if [[ $VERBOSE == 'no' ]]
  then
    return
  fi

  task=$1
  shift

  describe=$1
  shift

  info=""

  if [[ $# -gt 0 ]]
  then
    info="-> $*"
  fi

  echo >/dev/stderr "vc: [${task}] $describe $info"
}

#
# error - produce a formatted error message but do
#         not exit
#

# task        = the task that failed
# status      = the exit status of the command that failed
# description = description of the task that failed

function error {
  task=$1
  shift

  status=$1
  shift

  describe=$1
  shift

  echo >/dev/stderr "vc: [${task}] error! (${status}) ${describe} > $*"
}

#
# abort - print error information and exit 1
#

# task          = the task that failed
# description   = description of what failed
# status        = the exit status of the command that failed

function abort {
  task=$1
  shift

  describe=$1
  shift

  exit_code=""

  if [[ $# -gt 0 ]]
  then
    exit_code=$1
  fi

  if [[ -n $exit_code ]]
  then
    exit_code="(${exit_code})"
  fi

  echo >/dev/stderr "vc: [${task}] abort! $exit_code $describe > \"$*\""
  exit 1
}

#
# try - try to execute a command with verbosity and error calls
#       baked in.
#

# command     = command to execute
# task        = the task at hand
# description = describe what is being done
# @           = remaining args are passed to command

# RETURN      = status of command
function try {
  command=$1
  shift

  task=$1
  shift

  describe=$1
  shift

  verbosity "$task" "$describe" "$command" $@

  ignore='false'

  if echo "$command" | grep -E '^@' >/dev/null 2>&1
  then
    ignore='true'
    command=`echo $command | sed -e 's,^@,,'`
  fi

  exit_status=""

  if [[ "$DRY" == "yes" ]]
  then
    echo "dry run [$task]: $command $*"
    exit_status=0
  else
    $command $@
    exit_status=$?
  fi

  if [[ "$ignore" == "true" ]]
  then
    return $exit_status
  fi

  if [[ $exit_status -gt 0 ]]
  then
    error "$task" $exit_status "$describe" "$command" $@
  fi

  return $exit_status
}

#
# try_no_blanks - try to execute a command with verbosity 
#                 and error calls baked in. also filters
#                 out blank lines.
#

# command     = command to execute
# task        = the task at hand
# description = describe what is being done
# @           = remaining args are passed to command

# RETURN      = status of command
function try_no_blanks {
  command=$1
  shift

  task=$1
  shift

  describe=$1
  shift

  ignore='false'

  if echo "$command" | grep -E '^@' >/dev/null 2>&1
  then
    ignore='true'
    command=`echo $command | sed -e 's,^@,,'`
  fi

  verbosity "$task" "$describe" "$command" $@

  exit_status=""

  if [[ "$DRY" == "yes" ]]
  then
    echo "dry run [$task]: $command $* | grep -v -E \'^$\'"
    exit_status=0
  else
    $command $@ | grep -v -E '^$'
    exit_status=$?
  fi

  if [[ "$ignore" == "true" ]]
  then
    return $exit_status
  fi

  if [[ $exit_status -gt 0 ]]
  then
    error "$task" $exit_status "$describe" "$command" $@
  fi

  return $exit_status
}

function root_to_branch {
  branch=$(git branch | grep '*' | cut -d ' ' -f 2)

  if [[ $branch == "${INTEGRATION}" ]]
  then
    if [[ $1 == "norelease" ]]
    then
      root="${MAIN}"
    else
      root=$(git tag | grep release | sort -V | tail -n 1)
    fi
  else
    root="${INTEGRATION}"
  fi

  for check in "$root" "$branch"
  do
    if ! git branch | grep "$check" >/dev/null 2>&1
    then
      error "root_to_branch" "checking that branch exists" "$?" "branch $check required for operation"
    fi
  done
}

function create_tag {
  type=$1
  message=$2

  if [[ $# -gt 0 ]]
  then
    type=$1
    shift
  else
    abort "create_tag" "no argument given for type" "NA"
  fi


  if [[ $# -gt 0 ]]
  then
    feature=$1
    shift
  else
    abort "create_tag" "no argument given for feature" "NA"
  fi

  if [[ $# -gt 0 ]]
  then
    message=$1
    shift
  else
    abort "create_tag" "no argument given for message" "NA"
  fi

  case $type in
    "beta")
      if git tag | grep "${type}: ${USER}/${feature}"
      then
        count=$(git tag | grep "${type}-${USER}/${feature}" | wc -l)
        count=$((count + 1))

        TAG="${type}-${USER}/${feature}-${count} ${message}"
      else
        TAG="${type}-${USER}/${feature}-1 ${message}"
      fi
    ;;
    "release")
      # feature is the version in this case 
      TAG="release-${feature} ${message}"
    ;;
    *)
      abort "create_tag" "type: $type is not recognized." "NA"
    ;;
  esac

  echo >/dev/stderr "tag is: $TAG with $message"

  read -p "create tag? [y/n]: " choice

  if [[ $choice == "y" ]]
  then
    git tag -a -m $TAG
  else
    abort "create_tag" "aborted creating tag: $TAG"
  fi
}

#
# vc_options
#

# -v        : verbose
# -d        : dry run
# -t        : trace

function vc_options {
  VC_ARGS=()

  while [[ $# -gt 0 ]]
  do
    if [[ "$1" == "-v" ]]
    then
      VERBOSE='yes'
      shift
      continue
    fi

    if [[ "$1" == "-d" ]]
    then
      DRY='yes'
      shift
      continue
    fi

    if [[ "$1" == "-t" ]]
    then
      TRACE='yes'

      set -x 

      shift
      continue
    fi

    VC_ARGS+=("$1")
    shift
  done
}


function git_reset_args {
  VC_ARGS=()
}

#
# git_scrub_arguments
#

# sometimes we get weird VC_ARGS that are empty but the count
# is 1. This is extremely difficult to track down without a bash
# ultra deep dive. Its far more time effective to scrub the
# VC_ARGS array.

function git_scrub_arguments {
  clean=()
  count=0

  echo "in clean arguments"

  for arg in ${VC_ARGS[@]}
  do
    count=$(($count + 1))

    if echo "$arg" | grep -E '^[[:space:]]*$'
    then
      continue
    fi

    clean+=($arg)
  done

  if [[ $count -gt 0 ]]
  then
    VC_ARGS=clean
    return
  fi

  VC_ARGS=()
}

#
# git_arguments - process CLI arguments for git_options
#

# -compact      = show oneline compact form
# -stat         = show diffstat output
# -graph        = show graph of commit history
# -details      = show branch details in log output
# -decorate     = decorate history with branch information
# -color        = color history output
# -no-color     = don't color history output
# -v            = verbose
# -diff         = use a diff operation
# -emacs        = use emacs as a difftool or mergetool
# return

# SHOW          = git flag to specify output type
# STAT          = git 
# DIFF          = yes if showing diff instead of logs
# COLOR         = yes to color output
# VERBOSE       = yes/no to enable verbosity
function git_arguments {
  remaining=()

  SHOW=""
  STAT=""
  DIFF="no"
  TOOL="no"

  for arg in ${VC_ARGS[@]} $@
  do
    if [[ "$arg" == "-v" ]]
    then
      VERBOSE='yes'
      continue
    fi

    if [[ "$arg" == "-stat" ]]
    then
      STAT="--stat"
      continue
    fi

    if [[ "$arg" == "-color" ]]
    then
      COLOR='yes'
      continue
    fi

    if [[ "$arg" == "-no-color" ]]
    then
      COLOR='no'
      continue
    fi

    if [[ "$arg" == "-diff" ]]
    then
      DIFF='yes'
      continue
    fi

    if [[ "$arg" == "-tool" ]]
    then
      TOOL='yes'
      continue
    fi

    if [[ "$arg" == "-compact" ]]
    then
      SHOW="--oneline"
      continue
    fi

    if [[ "$arg" == "-details" ]]
    then
      SHOW="--pretty=fuller"
      continue
    fi

    if [[ "$arg" == "-graph" ]]
    then
      SHOW="--graph"
      continue
    fi

    remaining+=($arg)
  done

  VC_ARGS=$remaining

  git_scrub_arguments
}

#
# git_options
#

# :custom          = <branch>...?<trunk> or <trunk>...?<branch>
# :upstream        = execute against upstream branch
# :no-merges       = do not show merges
# :only-merges     = only show merges
# :merge           = use ... spec to show changes not in <trunk> and <branch>

# DATE             = date format
# COLOR            = yes/no show in color
# SHOW             = flags for output type and format
# VC_ARGS          = remaining arguments from common option processing

#
# return STATUS    = 0 if succesful, 1 if there was an error
#

# pre_options[@]   = this array contains the options that follow
#                    a git command, but before inserted options
#                    and post_options
# post_options[@]  = this array contains the options that are
#                    at the end of a git command.
function git_options {
  remaining=()

  merging='false'
  upstream="false"

  merge_flags=()

  spec=""

  type="changes"

  OP=''

  for arg in ${VC_ARGS[@]} $@
  do
    if [[ "$arg" == ":upstream" ]]
    then
      upstream='true'
      continue
    fi

    if [[ "$arg" == ":no-merges" ]]
    then
      merge_flags=("--first-parent")
      continue
    fi

    if [[ "$arg" == ":only-merges" ]]
    then
      merging='true'
      merge_flags=("--merges")
      continue
    fi

    if [[ "$arg" == ":merge" ]]
    then
      merging='true'
      continue
    fi

    if echo "$arg" | grep -E '^=' >/dev/null 2>&1
    then
      spec=`echo $arg | sed -e s,^=,,`
      continue
    fi

    if echo "$arg" | grep -E '^!' >/dev/null 2>&1
    then
      OP=`echo $arg | sed -e s,^!,,`
      continue
    fi

    remaining+=($arg)
  done

  VC_ARGS=$remaining

  git_scrub_arguments

  if [[ -z $spec ]]
  then
    case $type in
      "changes")
        if [[ "$upstream" == 'true' ]]
        then
          spec="HEAD..@{upstream}"
        else
          root_to_branch norelease
          spec="${root}..${branch}"
        fi
      ;;
      "merging")
        if [[ "$upstream" == 'true' ]]
        then
          spec="HEAD...@{upstream}"
        else
          root_to_branch norelease
          spec="${root}...${branch}"
        fi
      ;;
      *)
        abort "git_options" "log type not specified" "NA"
      ;;
    esac
  fi

  case $COLOR in
    "yes")
      COLOR="--color"
    ;;
    "no")
      COLOR=""
    ;;
  esac

  if [[ -z $OP ]]
  then
    OP="log"

    if [[ "$DIFF" == 'yes' ]]
    then
      OP="diff"
    fi

    if [[ "$TOOL" == 'yes' ]]
    then
      OP="difftool"
    fi
  fi

  if [[ "$OP" != "log" ]]
  then
    DATE=""
  fi

  pre_options=($OP $DATE $COLOR $merge_flags)

  post_options=($SHOW $STAT $spec)

  if [[ ${#files[@]} -gt 0 ]]
  then
    post_options+=(${post_options[@]} "--follow" "--" ${files[@]})
  fi

  verbosity "git_options" "generated options" ${pre_options[@]} ${post_options[@]}
}

#
# semantic_commits
#

# type   = release|main
# filter = semantic tag to filter by

function semantic_commits {
  git_options :no-merges

  REPORT=`try "git" "semantic_commits" "get list of commits" ${pre_options[@]} ${post_options[@]}`
}

function get_semantics {
  filter=$1;
  echo "$REPORT" | grep $filter | tr -s ' ' | cut -d ' ' -f 2-
}

function print_report {
  if [[ -n $features ]]
  then
    cat <<MESSAGE

* features

$features
MESSAGE
  fi

  if [[ -n $bugs ]]
  then
    cat <<MESSAGE

* bugs

$bugs
MESSAGE
  fi

  if [[ -n $fixes ]]
  then
    cat <<MESSAGE

* fixes

$fixes
MESSAGE
  fi

  if [[ -n $syncs ]]
  then
    cat <<MESSAGE

* syncs

$syncs
MESSAGE
  fi

  if [[ -n $refactor ]]
  then
    cat <<MESSAGE

* refactor

$refactor
MESSAGE
  fi
}

case $1 in
  "tools-zshrc")
    cp "${VCSH_SHELL}/zshrc.rc" $HOME/.zshrc
    verbosity "tools-zshrc" "replaced .zshrc with current version"
    ;;
  "tools-custom")
    cp "${VCSH_SHELL}/zshrc.custom" $HOME/.zshrc.custom
    verbosity "tools-custom" "replaced .zshrc.custom with current version"
    ;;
  "tools-prompt")
    cp "${VCSH_SHELL}/zshrc.prompt" $HOME/.zshrc.prompt
    verbosity "tools-prompt" "replaced prompt with current version"
    ;;

  "tools-brew-init")
    test -d /opt/homebrew || sudo mkdir -p /opt/homebrew
    curl -L https://github.com/Homebrew/brew/tarball/master >/tmp/brew.xz
    sudo tar xJf /tmp/brew.xz --strip 1 -C /opt/homebrew
    sudo chown -R mattie /opt/homebrew
    ;;

  "tools-brew-upgrade")
     $VCSH_ARCH_COMMAND brew update
     $VCSH_ARCH_COMMAND brew upgrade
  ;;
  "tools-brew-install")
    shift

    $VCSH_ARCH_COMMAND brew install $@
  ;;
  "tools-brew-rebuild")
    $VCSH_ARCH_COMMAND brew list | xargs arch -arm64 brew reinstall
  ;;
  "dependencies-init")
    test -d /opt/dependencies || sudo mkdir -p /opt/dependencies
    curl -L https://github.com/Homebrew/brew/tarball/master >/tmp/brew.xz
    sudo tar xJf /tmp/brew.xz --strip 1 -C /opt/dependencies
    sudo chown -R mattie /opt/dependencies
  ;;

  "dependencies-upgrade")
    eval $(${DEP_BREW}bin/brew shellenv)

    $VCSH_ARCH_COMMAND brew update
    $VCSH_ARCH_COMMAND brew upgrade
  ;;

  "dependencies-install")
    shift

    eval $(${DEP_BREW}bin/brew shellenv)
    $VCSH_ARCH_COMMAND brew install $*
  ;;

  #
  # modules
  #
  "modinit")
    git submodule init
    git submodule update --init
    ;;
  "modadd")
    shift

    if [[ -z "$1" || -z "$2" || -z "$3" ]]
    then
      abort "modadd" "submodule command requires <repo> <branch> <local>" "NA"
    fi

    if git submodule add -b $2 $1 $3
    then
      echo "vcsh: add ok. please remember to commit"
    else
      echo "vcsh: add failed. cleanup required."
      exit 1
    fi
    ;;
  "modsync")
    if git pull --recurse-submodules
    then
      echo "vcsh: update ok. please remember to test and commit."
    else
      echo "vcsh: update failed. cleanup required."
      exit 1
    fi
    ;;
  "modupdate")
    shift

    if [[ -z $1 ]]
    then
      echo "vcsh: update a submodule requires a submodule path"
      exit 1
    fi

    if git submodule update --remote $1
    then
      echo "vcsh: update ok. please remember to test and commit."
    else
      echo "vcsh: update failed. cleanup required."
      exit 1
    fi
    ;;
  "modbranch")
    shift

    if [[ -z $1 || -z $2 ]]
    then
      echo "vcsh: update a submodule requires a submodule path and a branch"
      exit 1
    fi

    if (cd $1 && git checkout $2)
    then
      echo "vcsh: switch to branch $2 ok. please remember to commit."
    else
      echo "vcsh: switch submodule $1 to branch $2 failed. cleanup required."
    fi
    ;;
  "modrm")
    shift

    if git rm $1 && git rm -f $1
    then
      if [[ -d $1 ]]
      then
        rm -rf $1
        echo "manual cleanup of source tree $1 done."
      fi

      if [[ -d ".git/modules/$1" ]]
      then
        rm -rf ".git/modules/$1"
        echo "manual cleanup of git module $1 done."
      fi

      echo "vcsh: removal of $1 succeeded."
    else
      echo "vcsh: removal of $1 failed. Repo is in a unknown state"
    fi
    ;;
  "modall")
    echo "all submodule updating..."
    git submodule update --init --recursive || exit 1
    echo "all submodule update done."
    ;;
  #
  # feature branches
  #

  "begin")
    shift

    vc_options $@
    name=$1

    if [[ -z $name ]]
    then
      abort "begin" "name required for a new feature branch" "NA"
    fi

    try git "begin" "checkout the feature branch" checkout -b "${FEATURE}/${name}"

    if [[ $? -ne 0 ]]
    then
      abort "begin" "error creating feature branch $name" "NA"
    fi

    verbosity "begin" "new feature branch \"$name\""
   ;;
  "end")
    shift

    vc_options $@
    name=${VC_ARGS[0]}

    if [[ -z $name ]]
    then
      abort "end" "get name of branch" "NA"
    fi

    if ! git branch | grep "${FEATURE}/${name}" >/dev/null 2>&1
    then
      abort "end" "feature branch ${name} not found" "NA"
    fi

    try git "end" "checkout trunk" checkout "${INTEGRATION}"

    checkout_status=$?

    if $[[ $checkout_status -gt 0 ]]
    then
      abort "end" "error switching to ${INTEGRATION} branch for merging ${name}" $checkout_status
    fi
    ;;
  "bug")
    shift

    vc_options $@
    name=${VC_ARGS[0]}

    if [[ -z $name ]]
    then
      abort "bug" "name of the bugfix branch to open is missing." "NA"
      exit 1
    fi

    try git "bug" "checkout the bugfix branch" checkout -b "${BUGFIX}/${name}"

    if [[ $? -ne 0 ]]
    then
      abort "begin" "error creating bugfix branch $name" "NA"
    fi

    verbosity "bug" "new bugfix branch \"$name\""
    ;;
  "close")
    shift

    vc_options $@
    name=${VC_ARGS[0]}

    if [[ -z $name ]]
    then
      abort "close" "name of the bugfix branch to close is missing." "NA"
      exit 1
    fi

    git flow bugfix finish $name
    ;;
  "goto")
    shift
    
    vc_options $@
    name=${VC_ARGS[0]}

    if [[ -z $name ]]
    then
      abort "goto" "name of the bug or feature branch required" "NA"
    fi

    if [[ "$name" == "$INTEGRATION" || "$name" == "$MAIN" ]]
    then
      exec git checkout "$name"
    fi

    if git branch | grep "${FEATURE}/$name" >/dev/null 2>&1
    then
      verbosity "goto" "checking out feature: $name"
      exec git checkout "feature/${name}"
    fi

    if git branch bugfix | grep "$name" >/dev/null 2>&1
    then
      verbosity "goto" "checking out bugfix: $name"
      exec git checkout "bugfix/${name}"
    fi

    abort "goto" "\"$name\" not found in features or bugfixes" "NA"
    ;;    
  "beta")
    shift

    vc_options $@
    message=${VC_ARGS[0]}

    if [[ -z $message ]]
    then
      abort "beta - message argument is missing."
    fi

    create_tag "beta" "$FEATURE" "$MESSAGE"
    ;;
  "add")
    shift

    vc_options $@

    if [[ ${#VC_ARGS[@]} -lt 2 ]]
    then
      abort "add" "add requires 2 arguments <name> <url>" "NA"
    fi

    NAME=${VC_ARGS[0]}

    if [[ -z $NAME ]]
    then
      abort "add" "vcsh add - repo name is missing." "NA"
    fi

    URL=${VC_ARGS[1]}

    if [[ -z $URL ]]
    then
      abort "add" "vcsh add - repo URL is missing." "NA"
    fi

    try git "add" "add a new remote" remote add "$NAME" "$URL"
    try git "add" "fetch from remote" fetch "$NAME"
  ;;
  "track")
    shift

    vc_options $@

    if [[ ${#VC_ARGS[@]} -lt 3 ]]
    then
      abort "track" "track requires 3 arguments <local> <remote> <branch>" "NA"
    fi

    LOCAL=${VC_ARGS[0]}

    if [[ -z $LOCAL ]]
    then
      abort "track" "vcsh track - local branch (1) is missing." "NA"
    fi

    REMOTE=${VC_ARGS[1]}

    if [[ -z $REMOTE ]]
    then
      abort "track" "vcsh track - remote (2) is missing." "NA"
    fi

    BRANCH=${VC_ARGS[2]}

    if [[ -z $BRANCH ]]
    then
      abort "track" "vcsh track - branch (3) is missing." "NA"
    fi

    try git "track" "track a new remote branch" checkout -b $LOCAL $REMOTE/$BRANCH
    ;;
  "diff")
    shift

    vc_options $@
    git_arguments "-diff"

    if [[ ${#VC_ARGS[@]} -gt 0 ]]
    then
      BRANCH=${VC_ARGS[0]}
      git_options "=HEAD..${BRANCH}"
    else
      git_options
    fi

    try "git" "diff" "diff against parent or given branch" ${pre_options[@]} ${post_options[@]}
  ;;
  "report")
    shift

    vc_options $@
    git_arguments

    semantic_commits

    features=`get_semantics feat`
    fixes=`get_semantics fix`
    bugs=`get_semantics bug`
    issues=`get_semantics issue`
    syncs=`get_semantics sync`
    refactor=`get_semantics refactor`

    print_report
    ;;
  "status")
    shift

    vc_options $@

    try_no_blanks git "status:branches" "git banch" branch -vv $color

    output=`try_no_blanks "@git" "status" "ls-files" ls-files --others --exclude-standard`
    if [[ -n $output ]]
    then
      echo "[untracked]" >/dev/stderr 2>&1
      echo "$output" >/dev/stderr 2>&1
    fi
      
    output=`try_no_blanks "@git" "status" "diff staged" diff --staged --stat $color`
    if [[ -n $output ]]
    then
      echo "[staged]"
      echo "$output" >/dev/stderr 2>&1
    fi

    output=`try_no_blanks "@git" "status" "changes diffstat" diff --stat $color`
    if [[ -n $output ]]
    then
      echo "[changes]"
      echo "$output" >/dev/stderr 2>&1
    fi
    ;;
  "verify")
    shift

    vc_options $@
    git_arguments
    git_options

    try git "verify" "verify signatures of logs" ${pre_options[@]} --show-signature ${post_options[@]}
    ;;
  "show")
      shift

      vc_options $@

      git_arguments -compact -no-color
      git_options
      
      git_scrub_arguments

      if [[ ${#VC_ARGS[@]} -lt 1 ]]
      then
        echo "this is the point: ${VC_ARGS[@]}"

        try "git" "show" "attempting to get last commit (no arg)" "show"
        exit $?
      fi

      if [[ "${VC_ARGS[0]}" == "-l" ]]
      then 
        try git "show" "a numbered list list of commits" ${pre_options[@]} ${post_options[@]} | nl
        exit $?
      fi

      if [[ "${VC_ARGS[0]}" == "-n" ]]
      then
        number="${VC_ARGS[1]}"

        if [[ -z $number ]]
        then
          abort "show" "-n requires a number of the git log line" "NA"
        fi

        commit=`try git "show" "show a numbered commit" ${pre_options[@]} ${post_options[@]} | sed -n -e "${number}p" | tr -s ' ' | cut -d ' ' -f 1`

        verbosity "show" "commit number is: ${number} found commit id: $commit"

        git_reset_args
        git_arguments -compact
        git_options  "=$commit" "!show"

        try git "show" "show numbered commit" ${pre_options[@]} ${post_options[@]}
      fi
     ;;
  "get")
    shift

    vc_options $@
    
    branch=${VC_ARGS[0]}

    if [[ -z $branch ]]
    then
      abort "get" "branch argument (1) not specified" "NA"
    fi

    remote=${VC_ARGS[1]}

    if [[ -z $remote ]]
    then
      abort "get" "remote argument (2) not specified" "NA"
    fi
      
    try_no_blanks "git" "get" "checkout remote branch" checkout "${remote}/${branch}"
    ;;
  "patch")
    shift

    vc_options $@

    git_options

    try git "patch" "generate patch (git diff)" diff -p --no-color | sed -e 's,^--- [ab]/,--- ,' | sed -e 's,^+++ [ab]/,+++ ,'
    ;;
  "pending")
    shift

    vc_options $@

    git_arguments $@

    git_options :merge

    try_no_blanks "git" "pending" "show work not in root" ${pre_options[@]} ${post_options[@]}
    exit $?
    ;;
  "list")
    shift

    vc_options $@
    set -- ${VC_ARGS[@]}

    git_arguments $@
    set -- ${VC_ARGS[@]}

    git_options $@

    case $1 in
      "merges")
        git_options ":only-merges" $@
        try_no_blanks "git" "merges" "log of merges only" ${pre_options[@]} ${post_options[@]}
      ;;
      "releases")
        try_no_blanks "git" "merges" "log of merges only" tag | grep release | sort -V | grep -v -E '^$'
      ;;
      "bugfixes")
        try_no_blanks git "list" "list of branches filtered for BUGFIX" branch | grep "${BUGFIX}"
      ;;    
      "features")
        try_no_blanks git "list" "list of branches filtered for FEATURE" branch | grep "${FEATURE}"
      ;;
      *)
        abort "list" "list type argument missing" "NA"
      ;;
    esac
    ;;
  "history")
    shift

    vc_options $@
    git_arguments
    git_options

    try_no_blanks "git" "history" "show commits on current branch" ${pre_options[@]} ${post_options[@]}
    ;;
  "ahead")
    shift

    vc_options $@
    git_arguments
    git_options

    try_no_blanks "git" "ahead" 'show commits in branch, not trunk' ${pre_options[@]} ${post_options[@]}
    ;;
  "behind")
    shift

    vc_options $@

    git_arguments $@

    root_to_branch norelease

    git_options

    try_no_blanks "git" "behind" "show commits on trunk not in branch" ${pre_options[@]} ${post_options[@]}
    ;;
  "up")
    git push origin "${MAIN}:${MAIN}"
    git push origin "${INTEGRATION}:${INTEGRATION}"

    git push --tags
    ;;
  "down")
    shift

    git fetch origin ${MAIN}
    git fetch origin ${INTEGRATION}

    git_arguments $@
    git_options :upstream

    try_no_blanks "git" "down" "fetch and show commits upstream not local" ${pre_options[@]} ${post_options[@]}
    ;;
  "merge")
    shift

    vc_options $@

    if [[ ${#VC_ARGS[@]} -gt 0 ]]
    then
      branch=${VC_ARGS[0]}
    else
      root_to_branch norelease
      try "git" "merge" "checkout the root: ${root} for merge" checkout ${root}
    fi

    verbosity "merge" "merge ${branch}"

    try "git" "merge" "merge no ff from: ${branch}" merge --no-ff ${branch}
    ;;
  "pull")
    shift

    vc_options $@

    root_to_branch norelease

    verbosity "merge" "merge from ${root}"

    try "git" "merge" "merge no ff from: ${root}" merge --no-ff ${root}
    ;;
  "rb")
    shift

    vc_options $@

    git_arguments -diff $@

    rollback_arguments=()

    case $1 in
      "idx")
        # rollback index from HEAD, unstaging
        # no files are damaged
        rollback_arguments=("restore" "--staged")

       try_no_blanks git "rb idx" "diff staged" ${pre_options[@]} --staged ${post_options}

       prompt="staged changes"
      ;;
      "wrk")
        # rollback workarea from discarding any
        # unstaged changes
        rollback_arguments=("restore") 

        try_no_blanks git "rb wrk" "diff unstaged" ${pre_options[@]} ${post_options}

        prompt="local changes"
      ;;
      "mrg")
        # rollback merge
        rollback_arguments=("merge" "--abort")

        try_no_blanks git "rb mrg" "diff staged" ${pre_options[@]} --staged ${post_options}

        prompt="merge"
      ;;
      *)
        abort "rb" "unknown rollback target" "NA" $1
      ;;
    esac

    read -p "vc: rollback $prompt [y/n]? " rollback

    if [[ "$rollback" != "y" ]]
    then
      abort "rb" "aborting with non \"y\" response" "NA"
    fi

    try "git" "rb" "rollback work area from the index" @rollback_arguments
  ;;

  #
  # release commands
  #

  "check")
    verbosity "check" "fetching new commits from remote"
    git fetch origin develop

    echo "===> showing unmerged differences <===="

    verbosity "check" "showing unmerged differences"

    git log develop..origin/develop --oneline

    echo "===> checking if working tree is dirty <==="

    if git diff --quiet >/dev/null 2>&1
    then
      echo "working tree clean - proceed!"
    else
      echo "working tree dirty - DO NOT RELEASE"

      git status
      exit 1
    fi
    ;;
  "start")
    shift

    $0 check

    echo "EDITOR is: $EDITOR ... correct?"

    read -p "Proceed? [y/n]: " proceed

    if [[ $proceed = "y" ]]
    then
      echo ">>> proceeding with release start!"
    else
      echo ">>> ABORT! exiting now!"
      exit 1
    fi

    VERSION="$1"

    echo -n "initiating git flow release start with version: $VERSION"

    git flow release start $VERSION

    if [[ $? -ne 0 ]]
    then
      echo "git flow release start $VERSION FAILED!"
      exit 1
    fi

    echo -n ">>>please edit python.sh with an updated version in 3 seconds."
    sleep 1
    echo -n "."
    sleep 1
    echo -n "."
    sleep 1

    $EDITOR python.sh || exit 1
    git add python.sh

    echo ">>>re-loading vc.sh"
    source vc.sh

    echo ">>>commit with release notes for version $VERSION"

    # don't do a automatic commit so a release summary can be inserted
    git commit

    echo "ready for release finish: please finish with vc release once you are ready"
    ;;
  "release")
    git flow release finish $VERSION || exit 1
    ;;
  "help")
    if [[ -n $2 ]]
    then
      filter="$2"
    else
      filter='\.*'
    fi

    echo "filter is $filter"

    cat <<HELP | grep "$filter"
vc

[tools commands]

tools-zshrc         = install hombrew, pyenv, and pyenv switching commands into .zshrc
tools-custom        = install zshrc.custom
tools-prompt        = install prompt support with pyeenv, git, and project in the prompt

[homebrew commands]

brew-upgrade        = upgrade brew packages

tools-brew-init     = initialize the /opt/homebrew homebrew repository
tools-brew-upgrade  = upgrade the /opt/homebrew repository
tools-brew-install  = install into /opt/homebrew a list of packages
tools-brew-rebuild  = rebuild packages in /opt/homebrew

dependencies-init     = initialize /opt/dependencies for stable and minimal deps to compile against
dependencies-upgrade  = upgrade /opt/dependencies 
dependencies-install  = install into /opt/dependencies a list of packages
dependencies-python   = install into /opt/dependencies python dependencies

[submodule]

modinit             = initialize and pull all submodules
modadd <1> <2> <3>  = add a submodule where 1=repo 2=branch 3=localDir (commit after)
modupdate <module>  = pull the latest version of the module
modsync             = pull and sync all modules to checked out commits
modrm  <submodule>  = delete a submodule
modall              = update all submodules

[version control]

status   = show status of repository
verify   = show log with signatures for verification
show     = show commit objects

history  = show commit history
pending  = commits not in root or branch
ahead    = show log of commits in branch but not in parent
behind   = show log of commit in parent but not branch

diff <branch> = diff against parent branch (default) 
patch         = generate a unified diff

rb       = rollback to idx,wrk,mrg for index,work, abort merge

[repository commands]

add <remote> <branch>   = check out a remote branch with the same name
get <branch> <upstream> = checkout a upstream branch
track <local> <remote> <branch> = checkout remote branch with a local name

[workflow]

up       = push up trunk and main to remote
down     = pull down trunk and main changes

merge    = merge branch into trunk
pull     = merge from trunk to branch

begin <name>  = start feature branch
end <name>    = close feature branch <name>

bug <name>    = start a bug branch
close <close> = finish a bugfix merging into develop

goto          = switch to feature or bugfix branch by name

[list branches & make reports]

list       = <merges|releases|features|bugfixes>
report     = generate a report of changes in branch, trunk, or main

[release]

beta <msg>       = create a beta tag with the message
check            = fetch main, develop, show log of any pending changes
start <version>  = start the release process for version
release          = execute git flow release finish with VERSION

HELP
  ;;
  *)
    $0 history $@
  ;;
esac

exit 0
