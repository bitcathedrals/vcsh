#! /usr/bin/env bash

# this will put us in bin/
VCSH=$(dirname $0)
# this will put is in the vcsh base directory
VCSH_BASE=$(dirname "$VCSH")

VCSH_SHELL="${VCSH_BASE}/shell/"

VCSH_BREW=""

VCSH_SYSTEM=$(uname)

EMACS_BREW="/opt/emacs/"
DEP_BREW="/opt/dependencies/"

case $VCSH_SYSTEM in
  "Darwin")
    VCSH_BREW="/opt/dependencies"

    if which arch >/dev/null 2>&1
    then
      VCSH_ARCH=$(arch)

      if [[ $VCSH_ARCH == "arm64" ]]
      then
        VCSH_ARCH_COMMAND="arch -arm64"
      fi
    fi
  ;;
esac

#
# default values
#

MAIN="main"
INTEGRATION="develop"
FEATURE="feature"
BUGFIX="bugfix"
RELEASE="release"
TAG="release"
VERSION=""

DATE_ARG="--date="
DATE_DEFAULT="relative"

VERBOSE='no'
DRY='no'
TRACE='no'
DEBUG='no'

OPTIONS=()
FILES=()



#
# debug
#

function debug {
  if [[ "$DEBUG" == "no" ]]
  then
    return
  fi    

  task=$1
  shift

  echo "DEBUG ($task) INFO = \"$*\""
  echo "DEBUG ($task) VC_ARGS = \"${VC_ARGS[@]}\""
  echo "DEBUG ($task) ARGUMENTS = \"${ARGUMENTS[@]}\""
  echo "DEBUG ($task) OPTIONS = \"${OPTIONS[@]}\""
  echo "DEBUG FILES ($task) args = ${FILES[@]}"
}

#
# verbosity - print information to stderr if VERBOSE = 'yes'
#

# task         = the task at hand
# description  = description of what is being performed
# @            = information for the user

function verbosity {
  if [[ $VERBOSE == 'no' ]]
  then
    return
  fi

  task=$1
  shift

  describe=$1
  shift

  info=""

  if [[ $# -gt 0 ]]
  then
    info="-> $*"
  fi

  echo >/dev/stderr "vc: [${task}] $describe $info"
}


#
# info -       print information to stderr if VERBOSE = 'yes'
#

# task         = the task at hand
# description  = description of what is being performed
# @            = information for the user

function info {
  task=$1
  shift

  describe=$1
  shift

  info=$1
  shift

  echo >/dev/stderr "vc: [${task}] $describe -> $info"
}

#
# error - produce a formatted error message but do
#         not exit
#

# task        = the task that failed
# status      = the exit status of the command that failed
# description = description of the task that failed

function error {
  task=$1
  shift

  status=$1
  shift

  describe=$1
  shift

  echo >/dev/stderr "vc: [${task}] error! (${status}) ${describe} > $*"
}

#
# abort - print error information and exit 1
#

# task          = the task that failed
# description   = description of what failed
# status        = the exit status of the command that failed

function abort {
  task=$1
  shift

  describe=$1
  shift

  exit_code=""

  if [[ $# -gt 0 ]]
  then
    exit_code=$1
  fi

  if [[ -n $exit_code ]]
  then
    exit_code="(${exit_code})"
  fi

  echo >/dev/stderr "vc: [${task}] abort! $exit_code $describe > \"$*\""
  exit 1
}

#
# vc.sh required and overrides
#

VC_CONFIG="vc.sh"
dir=$PWD

function load_vc_config {
  while [[ ! -e "${dir}/$VC_CONFIG" ]]
  do
    if [[ "$dir" == "$HOME" ]]
    then
      abort "load_vc_config" "cowardly refusing to search below HOME" "NA"
    fi

    if [[ "$dir" == "/" ]]
    then
      abort "load_vc_config" "practically refusing to search below /" "NA"
    fi

    if [[ -d "${dir}/.git" ]]
    then
      break
    fi

    dir=`dirname $dir`
  done

  test -e "${dir}/${VC_CONFIG}" && source "${dir}/${VC_CONFIG}"
}

load_vc_config

DATE="${DATE_ARG}${DATE:-$DATE_DEFAULT}"

#
# ask_yn      - ask with a prompt 
#

# prompt      - the prompt

# YN          - the result of the prompt, "y" or "n"

function ask_yn {
  YN=""

  while [[ -z $YN ]]
  do
    read -p "$1 y/n? " YN

    case $YN in
      "y")
        return 0
      ;;
      "n")
        return 1
      ;;
      *)
        echo "unrecognized answer $YN please try again." >/dev/stderr 2>&1
        YN=""
      ;;
    esac
  done
}

#
# try - try to execute a command with verbosity and error calls
#       baked in.
#

# command     = command to execute
# task        = the task at hand
# description = describe what is being done
# @           = remaining args are passed to command

# RETURN      = status of command
function try {
  command=$1
  shift

  task=$1
  shift

  describe=$1
  shift

  verbosity "$task" "$describe" "$command" $@

  ignore='false'

  if echo "$command" | grep -E '^@' >/dev/null 2>&1
  then
    ignore='true'
    command=`echo $command | sed -e 's,^@,,'`
  fi

  exit_status=""

  if [[ "$DRY" == "yes" ]]
  then
    echo "dry run [$task]: $command $*"
    exit_status=0
  else
    $command $@
    exit_status=$?
  fi

  if [[ "$ignore" == "true" ]]
  then
    return $exit_status
  fi

  if [[ $exit_status -gt 0 ]]
  then
    error "$task" $exit_status "$describe" "$command" $@
  fi

  return $exit_status
}

#
# try_no_blanks - try to execute a command with verbosity 
#                 and error calls baked in. also filters
#                 out blank lines.
#

# command     = command to execute
# task        = the task at hand
# description = describe what is being done
# @           = remaining args are passed to command

# RETURN      = status of command
function try_no_blanks {
  command=$1
  shift

  task=$1
  shift

  describe=$1
  shift

  ignore='false'

  if echo "$command" | grep -E '^@' >/dev/null 2>&1
  then
    ignore='true'
    command=`echo $command | sed -e 's,^@,,'`
  fi

  verbosity "$task" "$describe" "$command" $@

  exit_status=""

  if [[ "$DRY" == "yes" ]]
  then
    echo "dry run [$task]: $command $* | grep -v -E \'^$\'"
    exit_status=0
  else
    $command $@ | grep -v -E '^$'
    exit_status=$?
  fi

  if [[ "$ignore" == "true" ]]
  then
    return $exit_status
  fi

  if [[ $exit_status -gt 0 ]]
  then
    error "$task" $exit_status "$describe" "$command" $@
  fi

  return $exit_status
}

function root_to_branch {
  branch=$(git branch | grep '*' | cut -d ' ' -f 2)

  if [[ "$branch" == "${INTEGRATION}" ]]
  then
    root="${MAIN}"
    return
  fi

  if [[ "$branch" == "${MAIN}" ]]
  then
    root=$(git tag | grep release | sort -V | tail -n 1)
    return
  fi

  root="${INTEGRATION}"

  for check in "$root" "$branch"
  do
    if ! git branch | grep "$check" >/dev/null 2>&1
    then
      error "root_to_branch" "checking that branch exists" "$?" "branch $check required for operation"
    fi
  done
}

function beta_tag_count {
  count=$(git tag | grep "${feature}" | wc -l)

  if [[ -z $count ]]
  then
    BETA="1"
  else
    BETA=$(($count + 1))
  fi
}

function create_tag {
  if [[ $# -lt 3 ]]
  then
    abort "create_tag" "create_tag requires type,feature/version, and message arguments" "NA"
  fi

  type=$1
  shift

  identifier=$1
  shift

  message=$1
  shift

  case $type in
    "beta")
      beta_tag_count

      TAG="${identifier}-${BETA}"
    ;;
    "release")
      # feature is the version in this case 
      TAG="release-${identifier}"
    ;;
    *)
      abort "create_tag" "type: $type is not recognized." "NA"
    ;;
  esac

  info "tag" "create tag" "$TAG with \"$message\""

  if ask_yn "create tag"
  then
    try git "tag" "create a tag" tag -a "$TAG" -m "$message"
  else
    abort "create_tag" "aborted creating tag: $TAG"
  fi
}

#
# vc_options
#

# -v        : verbose
# -d        : dry run
# -t        : trace
# -x        : debug
function vc_options {
  VC_ARGS=()

  while [[ $# -gt 0 ]]
  do
    if [[ "$1" == "-v" ]]
    then
      VERBOSE='yes'
      shift
      continue
    fi

    if [[ "$1" == "-d" ]]
    then
      DRY='yes'
      shift
      continue
    fi

    if [[ "$1" == "-x" ]]
    then
      DEBUG='yes'
      shift
      continue
    fi

    if [[ "$1" == "-t" ]]
    then
      TRACE='yes'

      set -x 

      shift
      continue
    fi

    VC_ARGS+=("$1")
    shift
  done
}

#
# git_scrub_arguments
#

#
# git_arguments - process CLI arguments for git_options
#

# -compact      = show oneline compact form
# -stat         = show diffstat output
# -graph        = show graph of commit history
# -details      = show branch details in log output
# -decorate     = decorate history with branch information
# -color        = color history output
# -no-color     = don't color history output
# -v            = verbose
# -<n>          = limit number of entries returned
# -diff         = use a diff operation
# -emacs        = use emacs as a difftool or mergetool
# return

# LIMIT         = count of how many elements to limit output to.
# SHOW          = git flag to specify output type
# STAT          = git 
# DIFF          = yes if showing diff instead of logs
# COLOR         = yes to color output
# VERBOSE       = yes/no to enable verbosity
function git_arguments {
  ARGUMENTS=()

  SHOW=""
  STAT=""
  LIMIT=""
  DIFF="no"
  TOOL="no"

  debug "git_arguments" "beginning of function"

  for arg in ${VC_ARGS[@]} $@
  do
    if [[ "$arg" == "-v" ]]
    then
      VERBOSE='yes'
      continue
    fi

    if [[ "$arg" == "-stat" ]]
    then
      STAT="--stat"
      continue
    fi

    if [[ "$arg" == "-color" ]]
    then
      COLOR='yes'
      continue
    fi

    if [[ "$arg" == "-no-color" ]]
    then
      COLOR='no'
      continue
    fi

    if echo "$arg" | grep -E "^[[:digit:]]" >/dev/null 2>&1
    then
      LIMIT="-${arg}"
      continue
    fi

    if [[ "$arg" == "-diff" ]]
    then
      DIFF='yes'
      continue
    fi

    if [[ "$arg" == "-tool" ]]
    then
      TOOL='yes'
      continue
    fi

    if [[ "$arg" == "-compact" ]]
    then
      SHOW="--oneline"
      continue
    fi

    if [[ "$arg" == "-details" ]]
    then
      SHOW="--pretty=fuller"
      continue
    fi

    if [[ "$arg" == "-graph" ]]
    then
      SHOW="--graph"
      continue
    fi

    if [[ -e $arg ]]
    then
      FILES+=$arg
      continue
    fi

    ARGUMENTS+=$arg
  done

  debug "git_arguments" "end of git_arguments"
}

#
# git_options
#

# :custom          = <branch>...?<trunk> or <trunk>...?<branch>
# :upstream        = execute against upstream branch
# :no-merges       = do not show merges
# :only-merges     = only show merges
# :merge           = use ... spec to show changes not in <trunk> and <branch>

# DATE             = date format
# COLOR            = yes/no show in color
# SHOW             = flags for output type and format
# OPTIONS          = remaining arguments from common option processing

#
# return STATUS    = 0 if succesful, 1 if there was an error
#

# pre_options[@]   = this array contains the options that follow
#                    a git command, but before inserted options
#                    and post_options
# post_options[@]  = this array contains the options that are
#                    at the end of a git command.
function git_options {
  OPTIONS=()

  merging='false'
  upstream="false"

  merge_flags=()

  spec=""

  type="changes"

  OP=''

  debug "git_options" "at git_options entry point"

  for arg in ${ARGUMENTS[@]} $@
  do
    if [[ "$arg" == ":upstream" ]]
    then
      upstream='true'
      continue
    fi

    if [[ "$arg" == ":no-merges" ]]
    then
      merge_flags=("--first-parent")
      continue
    fi

    if [[ "$arg" == ":only-merges" ]]
    then
      merging='true'
      merge_flags=("--merges")
      continue
    fi

    if [[ "$arg" == ":merge" ]]
    then
      merging='true'
      continue
    fi

    if [[ "$arg" == ":none" ]]
    then
      type="local"
      continue
    fi

    if echo "$arg" | grep -E '^=' >/dev/null 2>&1
    then
      spec=`echo $arg | sed -e s,^=,,`
      continue
    fi

    if echo "$arg" | grep -E '^!' >/dev/null 2>&1
    then
      OP=`echo $arg | sed -e s,^!,,`
      continue
    fi

    OPTIONS+=$arg
  done

  debug "git_options" "after loop"


  if [[ "$OP" == "cat-file" ]]
  then
    type='local'
  fi

  if [[ -z $spec ]]
  then
    case $type in
      "changes")
        if [[ "$upstream" == 'true' ]]
        then
          spec="HEAD..@{upstream}"
        else
          root_to_branch
          spec="${root}..${branch}"
        fi
      ;;
      "merging")
        if [[ "$upstream" == 'true' ]]
        then
          spec="HEAD...@{upstream}"
        else
          root_to_branch
          spec="${root}...${branch}"
        fi
      ;;
      "local")
        spec=""
      ;;
      *)
        abort "git_options" "type not specified" "NA"
      ;;
    esac
  fi

  case $COLOR in
    "yes")
      COLOR="--color"
    ;;
    "no")
      COLOR=""
    ;;
  esac

  if [[ -z $OP ]]
  then
    OP="log"

    if [[ "$DIFF" == 'yes' ]]
    then
      OP="diff"
    fi

    if [[ "$TOOL" == 'yes' ]]
    then
      OP="difftool"
    fi
  fi

  if [[ "$OP" != "log" ]]
  then
    DATE=""
  fi

  if [[ "$SHOW" == "--oneline" ]]
  then
    DATE=""
  fi

  if [[ "$OP" == "cat-file" ]]
  then
    if [[ ${#FILES[@]} -lt 1 ]]
    then
      error "git_options" "NA" "cat-file no file argument" "cat-file"
    fi

    pre_options=($OP "-p")
    post_options=("${spec:-HEAD}:${FILES[0]}")
  else
    pre_options=($OP $DATE $COLOR $merge_flags)

    post_options=($SHOW $LIMIT $STAT $spec)

    if [[ ${#FILES[@]} -gt 0 ]]
    then
      post_options+=(${post_options[@]} "--" ${FILES[@]})
    fi
  fi

  debug "git_options" "after FILES processing"

  verbosity "git_options" "generated options" ${pre_options[@]} ${post_options[@]}
}

#
# semantic_commits
#

# type   = release|main
# filter = semantic tag to filter by

function semantic_commits {
  git_options :no-merges

  REPORT=`try "git" "semantic_commits" "get list of commits" ${pre_options[@]} ${post_options[@]}`
}

function get_semantics {
  filter=$1;
  echo "$REPORT" | grep $filter | tr -s ' ' | cut -d ' ' -f 2-
}

function print_report {
  if [[ -n $features ]]
  then
    cat <<MESSAGE

* features

$features
MESSAGE
  fi

  if [[ -n $bugs ]]
  then
    cat <<MESSAGE

* bugs

$bugs
MESSAGE
  fi

  if [[ -n $fixes ]]
  then
    cat <<MESSAGE

* fixes

$fixes
MESSAGE
  fi

  if [[ -n $syncs ]]
  then
    cat <<MESSAGE

* syncs

$syncs
MESSAGE
  fi

  if [[ -n $refactor ]]
  then
    cat <<MESSAGE

* refactor

$refactor
MESSAGE
  fi
}

case $1 in
  "tools-zshrc")
    cp "${VCSH_SHELL}/zshrc.rc" $HOME/.zshrc
    verbosity "tools-zshrc" "replaced .zshrc with current version"
    ;;
  "tools-custom")
    cp "${VCSH_SHELL}/zshrc.custom" $HOME/.zshrc.custom
    verbosity "tools-custom" "replaced .zshrc.custom with current version"
    ;;
  "tools-prompt")
    cp "${VCSH_SHELL}/zshrc.prompt" $HOME/.zshrc.prompt
    verbosity "tools-prompt" "replaced prompt with current version"
    ;;

  "tools-brew-init")
    test -d /opt/homebrew || sudo mkdir -p /opt/homebrew
    curl -L https://github.com/Homebrew/brew/tarball/master >/tmp/brew.xz
    sudo tar xJf /tmp/brew.xz --strip 1 -C /opt/homebrew
    sudo chown -R mattie /opt/homebrew
    ;;

  "tools-brew-upgrade")
     $VCSH_ARCH_COMMAND brew update
     $VCSH_ARCH_COMMAND brew upgrade
  ;;
  "tools-brew-install")
    shift

    $VCSH_ARCH_COMMAND brew install $@
  ;;
  "tools-brew-rebuild")
    $VCSH_ARCH_COMMAND brew list | xargs arch -arm64 brew reinstall
  ;;
  "dependencies-init")
    test -d /opt/dependencies || sudo mkdir -p /opt/dependencies
    curl -L https://github.com/Homebrew/brew/tarball/master >/tmp/brew.xz
    sudo tar xJf /tmp/brew.xz --strip 1 -C /opt/dependencies
    sudo chown -R mattie /opt/dependencies
  ;;

  "dependencies-upgrade")
    eval $(${DEP_BREW}bin/brew shellenv)

    $VCSH_ARCH_COMMAND brew update
    $VCSH_ARCH_COMMAND brew upgrade
  ;;

  "dependencies-install")
    shift

    eval $(${DEP_BREW}bin/brew shellenv)
    $VCSH_ARCH_COMMAND brew install $*
  ;;

  #
  # modules
  #
  "modinit")
    git submodule init
    git submodule update --init
    ;;
  "modadd")
    shift

    if [[ -z "$1" || -z "$2" || -z "$3" ]]
    then
      abort "modadd" "submodule command requires <repo> <branch> <local>" "NA"
    fi

    if git submodule add -b $2 $1 $3
    then
      echo "vcsh: add ok. please remember to commit"
    else
      echo "vcsh: add failed. cleanup required."
      exit 1
    fi
    ;;
  "modsync")
    if git pull --recurse-submodules
    then
      echo "vcsh: update ok. please remember to test and commit."
    else
      echo "vcsh: update failed. cleanup required."
      exit 1
    fi
    ;;
  "modupdate")
    shift

    if [[ -z $1 ]]
    then
      echo "vcsh: update a submodule requires a submodule path"
      exit 1
    fi

    if git submodule update --remote $1
    then
      echo "vcsh: update ok. please remember to test and commit."
    else
      echo "vcsh: update failed. cleanup required."
      exit 1
    fi
    ;;
  "modbranch")
    shift

    if [[ -z $1 || -z $2 ]]
    then
      echo "vcsh: update a submodule requires a submodule path and a branch"
      exit 1
    fi

    if (cd $1 && git checkout $2)
    then
      echo "vcsh: switch to branch $2 ok. please remember to commit."
    else
      echo "vcsh: switch submodule $1 to branch $2 failed. cleanup required."
    fi
    ;;
  "modrm")
    shift

    if git rm $1 && git rm -f $1
    then
      if [[ -d $1 ]]
      then
        rm -rf $1
        echo "manual cleanup of source tree $1 done."
      fi

      if [[ -d ".git/modules/$1" ]]
      then
        rm -rf ".git/modules/$1"
        echo "manual cleanup of git module $1 done."
      fi

      echo "vcsh: removal of $1 succeeded."
    else
      echo "vcsh: removal of $1 failed. Repo is in a unknown state"
    fi
    ;;
  "modall")
    echo "all submodule updating..."
    git submodule update --init --recursive || exit 1
    echo "all submodule update done."
    ;;
  #
  # feature branches
  #

  "begin")
    shift

    vc_options $@
    name=${VC_ARGS[0]}

    if [[ -z $name ]]
    then
      abort "begin" "name required for a new feature branch" "NA"
    fi

    try git "begin" "checkout the feature branch" checkout -b "${FEATURE}/${name}"

    if [[ $? -ne 0 ]]
    then
      abort "begin" "error creating feature branch $name" "NA"
    fi

    verbosity "begin" "new feature branch \"$name\""
   ;;
  "end")
    shift

    vc_options $@
    name=${VC_ARGS[0]}

    if [[ -z $name ]]
    then
      abort "end" "name of branch missing" "NA"
    fi

    if ! git branch | grep "${FEATURE}/${name}" >/dev/null 2>&1
    then
      abort "end" "feature branch ${name} not found" "NA"
    fi

    $0 merge
    ;;
  "bug")
    shift

    vc_options $@
    name=${VC_ARGS[0]}

    if [[ -z $name ]]
    then
      abort "bug" "name of the bugfix branch to open is missing." "NA"
      exit 1
    fi

    try git "bug" "checkout the bugfix branch" checkout -b "${BUGFIX}/${name}"

    if [[ $? -ne 0 ]]
    then
      abort "bug" "error creating bugfix branch $name" "NA"
    fi

    verbosity "bug" "new bugfix branch \"$name\""
    ;;
  "close")
    shift

    vc_options $@
    name=${VC_ARGS[0]}

    if [[ -z $name ]]
    then
      abort "end" "name of branch missing" "NA"
    fi

    if ! git branch | grep "${BUGFIX}/${name}" >/dev/null 2>&1
    then
      abort "end" "bug branch ${name} not found" "NA"
    fi

    $0 merge
    ;;
  "goto")
    shift
    
    vc_options $@
    name=${VC_ARGS[0]}

    if [[ -z $name ]]
    then
      verbosity "goto" "defaulting to trunk: $name"

      root_to_branch

      name="${root}"
    fi

    if [[ "$name" == "$INTEGRATION" || "$name" == "$MAIN" ]]
    then
      verbosity "goto" "checking out trunk: $name"
      try "git" "goto" "switch to trunk" switch "$name"

      exit $?
    fi

    if git branch | grep "${FEATURE}/$name" >/dev/null 2>&1
    then
      verbosity "goto" "checking out feature: $name"
      try "git" "goto" "switch to feature" switch "${FEATURE}/${name}"

      exit $?
    fi

    if git branch | grep "${BUGFIX}/$name" >/dev/null 2>&1
    then
      verbosity "goto" "checking out bugfix: $name"
      try "git" "goto" "switch to bugfix" switch "${BUGFIX}/${name}"

      echo $?
    fi

    abort "goto" "\"$name\" not found in features or bugfixes" "NA"
    ;;    
  "beta")
    shift

    vc_options $@

    feature=${VC_ARGS[0]}

    message=${VC_ARGS[1]}

    if [[ -z $feature ]]
    then
      abort "tag - version argument is missing."
    fi

    if [[ -z $message ]]
    then
      abort "tag - message argument is missing."
    fi

    create_tag "beta" "$feature" "$message"
    ;;
  "tag")
    shift

    vc_options $@

    version=${VC_ARGS[0]}

    message=${VC_ARGS[1]}

    if [[ -z $version ]]
    then
      abort "tag - version argument is missing."
    fi

    if [[ -z $message ]]
    then
      abort "tag - message argument is missing."
    fi

    create_tag "release" "$version" "$message"
    ;;
  "diff")
    shift

    vc_options $@
    git_arguments "-diff"

    if [[ ${#ARGUMENTS[@]} -gt 0 ]]
    then
      branch=${ARGUMENTS[0]}
      git_options "=HEAD..${branch}"
    else
      git_options
    fi

    try "git" "diff" "diff against parent or given branch" ${pre_options[@]} ${post_options[@]}
  ;;
  "report")
    shift

    vc_options $@
    git_arguments

    semantic_commits

    features=`get_semantics feat`
    fixes=`get_semantics fix`
    bugs=`get_semantics bug`
    issues=`get_semantics issue`
    syncs=`get_semantics sync`
    refactor=`get_semantics refactor`

    print_report
    ;;
  "status")
    shift

    vc_options $@

    try_no_blanks git "status:branches" "git banch" branch -vv $color

    output=`try_no_blanks "@git" "status" "ls-files" ls-files --others --exclude-standard`
    if [[ -n $output ]]
    then
      echo "[untracked]" >/dev/stderr 2>&1
      echo "$output" >/dev/stderr 2>&1
    fi
      
    output=`try_no_blanks "@git" "status" "diff staged" diff --staged --stat $color`
    if [[ -n $output ]]
    then
      echo "[staged]"
      echo "$output" >/dev/stderr 2>&1
    fi

    root_to_branch

    echo ">>>showing commits in $branch not $root (parent)"
    try_no_blanks "@git" "status:commits ahead" "log" log "${root}..${branch}" --oneline $color
    ;;
  "verify")
    shift

    vc_options $@
    git_arguments
    git_options

    try git "verify" "verify signatures of logs" ${pre_options[@]} --show-signature ${post_options[@]}
    ;;
  "commit")
    shift

    vc_options $@
    git_arguments -compact -no-color
    git_options

    if [[ ${OPTIONS[0]} -lt 1 ]]
    then 
      try git "commit" "chronology numbered list of commits" ${pre_options[@]} ${post_options[@]} | nl
      exit 0
    fi

    commit='none'

    for arg in ${OPTIONS[@]}
    do
      index=`echo "$arg" | sed  -e 's,^+,,g'`
      list=`try_no_blanks "git" "commit" "show log for commit number" ${pre_options[@]} ${post_options[@]} | head -n $index | tail -n 1`

      echo "$list" | tr -s ' ' | cut -d ' ' -f 1
    done
  ;;
  "show")
    shift

    vc_options $@

    git_arguments -compact

    if [[ ${#VC_ARGS[0]} -lt 1 ]]
    then
      git_options "!show"
      try git "show" "show last commit" ${pre_options[@]} ${post_options[@]}

      exit $?
    fi
 
    for entry in ${OPTIONS[@]}
    do
      commit=`echo "${entry}" | sed  -e 's,^+,,g'`

      git_options "=$commit" "!show"

      try git "show" "show numbered commit" ${pre_options[@]} ${post_options[@]}
    done
    ;;
  "get")
    shift

    vc_options $@
    git_arguments -compact

    if [[ ${#ARGUMENTS[@]} -gt 1 ]]
    then
      git_options

      remote=${OPTIONS[0]}
      branch=${OPTIONS[1]}

      try "git" "get" "fetch commits from $remote" fetch "$remote"
    else
      git_options ":upstream"

      current=`git branch | grep '\*' | cut -d ' ' -f 2`

      remote=`git config branch.${current}.remote`
      branch=`git config branch.${current}.merge | sed -e s,^.*/,,g`

      try "git" "get" "fetch commits from default remote" fetch
    fi
      
    try_no_blanks "@git" "get" "show commits in upstream" ${pre_options[@]} ${post_options[@]}

    if [[ $? -ne 0 ]]
    then
      abort "get" "no commits upstream" "NA"
    fi

    if ! ask_yn "merge upstream changes into current branch"
    then
      exit 0
    fi
     
    $0 merge "${remote}/${branch}"
    ;;
  "patch")
    shift

    vc_options $@
    git_arguments
    git_options

    try git "patch" "generate patch (git diff)" diff -p --no-color | sed -e 's,^--- [ab]/,--- ,' | sed -e 's,^+++ [ab]/,+++ ,'
    ;;
  "pending")
    shift

    vc_options $@
    git_arguments
    git_options

    try_no_blanks "git" "pending" "show work not in root" ${pre_options[@]} ${post_options[@]}
    exit $?
    ;;
  "list")
    shift

    vc_options $@
    git_arguments

    case $1 in
      "merges")
        git_options ":only-merges"
        try_no_blanks "git" "list" "log of merges only" ${pre_options[@]} ${post_options[@]}
      ;;
      "releases")
        try_no_blanks "git" "list" "log of merges only" tag | grep release | sort -V | grep -v -E '^$'
      ;;
      "bugfixes")
        try_no_blanks git "list" "list of branches filtered for BUGFIX" branch | grep "${BUGFIX}"
      ;;    
      "features")
        try_no_blanks git "list" "list of branches filtered for FEATURE" branch | grep "${FEATURE}"
      ;;
      *)
        abort "list" "list type argument missing" "NA"
      ;;
    esac
    ;;
  "history")
    shift

    vc_options $@
    git_arguments
    git_options

    try_no_blanks "git" "history" "show commits on current branch" ${pre_options[@]} ${post_options[@]}
    ;;
  "ahead")
    shift

    vc_options $@
    git_arguments
    git_options

    try_no_blanks "git" "ahead" 'show commits in branch, not trunk' ${pre_options[@]} ${post_options[@]}
    ;;
  "behind")
    shift

    vc_options $@
    git_arguments

    if [[ "${OPTIONS[0]}" == "trunk" ]]
    then
      root_to_branch
      git_options "=${branch}..${root}"
    else
      git_options ":upstream"
    fi

    try_no_blanks "@git" "behind" "show commits upstream/trunk not in branch" ${pre_options[@]} ${post_options[@]}
    ;;
  "up")
    shift
    vc_options $@

    try_no_blanks "@git" "up" "push main branch" push origin "${MAIN}:${MAIN}"
    try_no_blanks "@git" "up" "push trunk" push origin "${INTEGRATION}:${INTEGRATION}"

    try_no_blanks "@git" "up" "push tags" push --tags
    ;;
  "down")
    shift

    vc_options $@

    git_arguments
    git_options

    try "git" "down" "fetch from upstream" fetch origin

    try_no_blanks "git" "down" "show upstream commits" ${pre_options[@]} ${post_options[@]}
    ;;
  "merge")
    shift

    vc_options $@

    if [[ ${#VC_ARGS[@]} -gt 0 ]]
    then
      root=`git branch | grep '*' | cut -d ' ' -f 2`
      branch=${VC_ARGS[0]}
    else
      root_to_branch
      try "git" "merge" "switch to the root: ${root} for merge" checkout ${root}
    fi

    if ask_yn "merge $branch into \"$root\""
    then
      verbosity "merge" "merging ${branch}"

      try "git" "merge" "merge no ff from: ${branch}" merge --no-ff ${branch}
    else
      abort "merge" "answer to merge is no" "NA"
    fi
    ;;
  "pull")
    shift

    vc_options $@

    root_to_branch

    verbosity "pull" "merge from ${root}"

    try "git" "merge" "merge no ff from: ${root}" merge --no-ff ${root}
    ;;
  "push")
    shift

    vc_options $@

    root_to_branch

    verbosity "merge" "merge into ${root}"

    try "git" "switch" "switch to $INTEGRATION trunk" "switch" "$INTEGRATION"

    try "git" "merge" "merge no ff from: ${branch}" merge --no-ff ${branch}
    ;;
  "cat")
    shift

    vc_options $@
    git_arguments
    git_options "!cat-file"

    try "git" "cat" "cat the file to stdout" ${pre_options[@]} ${post_options[@]}
    ;;
  "rb")
    shift

    vc_options $@
    git_arguments "-no-color"

    debug "rb" "entering rb command"

    case ${ARGUMENTS[0]} in
      "index")
        # rollback index from HEAD, unstaging no files are damaged
        rollback_arguments=("--staged")

        git_options "!restore" ":none"
        prompt="staged changes"
      ;;
      "work")
        # rollback work area discarding any unstaged changes
        git_options "!restore" ":none"
        prompt="local changes"
      ;;
      "merge")
        # rollback merge
        git_options "!merge" ":none"
        rollback_arguments=("--abort")
        prompt="merge"
      ;;
      *)
        abort "rb" "unknown target: \"${OPTIONS[0]}\" choose index,work,merge" "NA"
      ;;
    esac

    $0 status

    if ask_yn "rollback $prompt"
    then
      try "git" "rb" "execute rollback" ${pre_options[@]} ${rollback_arguments[@]} ${post_options[@]}
    else
      abort "rb" "aborting with non \"y\" response" "NA"
    fi
  ;;

  #
  # release commands
  #

  "check")
    shift

    verbosity "check" "fetching new commits from remote"

    $0 down

    verbosity "check" "showing unmerged differences"

    vc_options $@

    git_arguments

    git_options :upstream

    try git "check" "show difference with remote changes" ${pre_options[@]} ${post_options[@]}

    verbosity "check" "checking if working tree is dirty"

    if git diff --quiet >/dev/null 2>&1
    then
      echo >/dev/stderr "vcsh: working tree clean - proceed!"
    else
      echo >/dev/stderr "vcsh: working tree dirty - DO NOT RELEASE"

      git status

      exit 1
    fi
    ;;
  "start")
    shift

    VERSION="$1"

    $0 check

    echo "EDITOR is: $EDITOR ... correct?"

    if ask_yn "proceed with release"
    then
      echo ">>> proceeding with release start!"
    else
      echo ">>> ABORT! exiting now!"
      exit 1
    fi

    echo -n "initiating git flow release start with version: $VERSION"

    git checkout -b "${RELEASE}/${VERSION}"

    if [[ $? -ne 0 ]]
    then
      echo "git flow release start $VERSION FAILED!"
      exit 1
    fi

    echo -n ">>>please edit vc.sh with an updated version in 3 seconds."
    sleep 1
    echo -n "."
    sleep 1
    echo -n "."
    sleep 1

    $EDITOR vc.sh || exit 1
    git add vc.sh

    echo ">>>re-loading vc.sh"
    source vc.sh

    echo ">>>commit with release notes for version $VERSION"

    # don't do a automatic commit so a release summary can be inserted
    git commit

    echo "ready for release: finish with vc release once you are ready"
    ;;
  "release")
    git flow release finish $VERSION || exit 1
    ;;
  "help")
    if [[ -n $2 ]]
    then
      filter="$2"
    else
      filter='\.*'
    fi

    echo "filter is $filter"

    cat <<HELP | grep "$filter"
vc

[tools commands]

tools-zshrc         = install hombrew, pyenv, and pyenv switching commands into .zshrc
tools-custom        = install zshrc.custom
tools-prompt        = install prompt support with pyeenv, git, and project in the prompt

[homebrew commands]

brew-upgrade        = upgrade brew packages

tools-brew-init     = initialize the /opt/homebrew homebrew repository
tools-brew-upgrade  = upgrade the /opt/homebrew repository
tools-brew-install  = install into /opt/homebrew a list of packages
tools-brew-rebuild  = rebuild packages in /opt/homebrew

dependencies-init     = initialize /opt/dependencies for stable and minimal deps to compile against
dependencies-upgrade  = upgrade /opt/dependencies 
dependencies-install  = install into /opt/dependencies a list of packages
dependencies-python   = install into /opt/dependencies python dependencies

[submodule]

modinit             = initialize and pull all submodules
modadd <1> <2> <3>  = add a submodule where 1=repo 2=branch 3=localDir (commit after)
modupdate <module>  = pull the latest version of the module
modsync             = pull and sync all modules to checked out commits
modrm  <submodule>  = delete a submodule
modall              = update all submodules

[version control]

status            = show status of repository
verify            = show log with signatures for verification
commit            = no arg, list numbered commits, +<num> print truncated SHA1
show -l |  <+num> = show commit objects, no arg last, -l list, +num line number

history  = show commit history
pending  = commits not in root or branch
ahead    = show log of commits in branch but not in parent
behind <trunk> = show upstream or "trunk" changes not in branch

diff <branch>  = diff against parent branch (default) 
patch          = generate a unified diff

rb       = rollback to index, work, merge

[repository commands]

get <branch> <upstream> = checkout a upstream branch

[workflow]

up       = push up trunk and main to remote
down     = pull down trunk and main changes

merge    = merge branch into trunk

pull     = merge from trunk to branch
push     = push changes from branch to trunk

begin <name>  = start feature branch
end <name>    = close feature branch <name>

bug <name>    = start a bug branch
close <close> = finish a bugfix merging into develop

goto          = switch to feature or bugfix branch by name

[list branches & make reports]

list       = <merges|releases|features|bugfixes>
report     = generate a report of changes in branch, trunk, or main

[release]

beta <msg>       = create a beta tag with the message
check            = fetch main, develop, show log of any pending changes
start <version>  = start the release process for version
release          = execute git flow release finish with VERSION

HELP
  ;;
  *)
    $0 history $@
  ;;
esac

exit 0
