#! /usr/bin/env bash

# this will put us in bin/
VCSH=$(dirname $0)
# this will put is in the vcsh base directory
VCSH_BASE=$(dirname "$VCSH")

VCSH_SHELL="${VCSH_BASE}/shell/"

VCSH_BREW=""

VCSH_SYSTEM=$(uname)

EMACS_BREW="/opt/emacs/"
DEP_BREW="/opt/dependencies/"

case $VCSH_SYSTEM in
  "Darwin")
    VCSH_BREW="/opt/dependencies"

    if which arch >/dev/null 2>&1
    then
      VCSH_ARCH=$(arch)

      if [[ $VCSH_ARCH == "arm64" ]]
      then
        VCSH_ARCH_COMMAND="arch -arm64"
      fi
    fi
  ;;
esac

#
# default values
#

MAIN="main"
INTEGRATION="develop"
FEATURE="feature"
BUGFIX="bugfix"
RELEASE="release"
TAG="release"
VERSION=""

DATE_ARG="--date="
DATE_DEFAULT="relative"

VERBOSE='no'
DRY='no'

#
# vc.sh, required and overrides
#

VC_CONFIG="vc.sh"
dir=$PWD

while [[ ! -e "${dir}/$VC_CONFIG" ]]
do
  if [[ "$dir" == "$HOME" ]]
  then
    break
  fi

  if [[ -d "${dir}/.git" ]]
  then
    break
  fi

  dir=`dirname $dir`
done

test -e "${dir}/${VC_CONFIG}" && source "${dir}/${VC_CONFIG}"

DATE="${DATE_ARG}${DATE:-$DATE_DEFAULT}"

#
# verbosity - print information to stderr if VERBOSE = 'yes'
#

# task         = the task at hand
# description  = description of what is being performed
# @            = information for the user

function verbosity {
  if [[ $VERBOSE == 'no' ]]
  then
    return
  fi

  task=$1
  shift

  describe=$1
  shift

  info=""

  if [[ $# -gt 0 ]]
  then
    info="> $*"
  fi

  echo >/dev/stderr "vc: [${task}] $describe $info"
}

#
# error - produce a formatted error message but do
#         not exit
#

# task        = the task that failed
# status      = the exit status of the command that failed
# description = description of the task that failed

function error {
  task=$1
  shift

  status=$1
  shift

  describe=$1
  shift

  echo >/dev/stderr "vc: [${task}] error! (${status}) ${describe} > $*"
}

#
# abort - print error information and exit 1
#

# task          = the task that failed
# description   = description of what failed
# status        = the exit status of the command that failed

function abort {
  task=$1
  shift

  describe=$1
  shift

  exit_code=""

  if [[ $# -gt 0 ]]
  then
    exit_code=$1
  fi
  shift

  if [[ -n $exit_code ]]
  then
    exit_code="(${exit_code})"
  fi

  echo >/dev/stderr "vc: [${task}] abort! $exit_code $describe > \"$*\""
  exit 1
}

#
# try - try to execute a command with verbosity and error calls
#       baked in.
#

# command     = command to execute
# task        = the task at hand
# description = describe what is being done
# @           = remaining args are passed to command

# RETURN      = status of command
function try {
  command=$1
  shift

  task=$1
  shift

  describe=$1
  shift

  verbosity "$task" "$describe" "$command" $@

  exit_status=""

  if [[ "$DRY" == "yes" ]]
  then
    echo "dry run [$task]: $command $*"
    exit_status=0
  else
    $command $@ | grep -v -E '^$'
    exit_status=$?
  fi

  if [[ $exit_status -gt 0 ]]
  then
    error "$task" "$command $status" "$describe" $@
  fi

  return $exit_status
}

#
# try_no_blanks - try to execute a command with verbosity 
#                 and error calls baked in. also filters
#                 out blank lines.
#

# command     = command to execute
# task        = the task at hand
# description = describe what is being done
# @           = remaining args are passed to command

# RETURN      = status of command
function try_no_blanks {
  command=$1
  shift

  task=$1
  shift

  describe=$1
  shift

  verbosity "$task" "$describe" "$command" $@

  exit_status=""

  if [[ "$DRY" == "yes" ]]
  then
    echo "dry run [$task]: $command $* | grep -v -E \'^$\'"
    exit_status=0
  else
    $command $@ | grep -v -E '^$'
    exit_status=$?
  fi

  if [[ $exit_status -gt 0 ]]
  then
    error "$task" "$command $status" "$describe" $@
  fi

  return $exit_status
}

function root_to_branch {
  branch=$(git branch | grep '*' | cut -d ' ' -f 2)

  if [[ $branch == "develop" ]]
  then
    if [[ $1 == "norelease" ]]
    then
      root="main"
    else
      root=$(git tag | grep release | sort -V | tail -n 1)
    fi
  else
    root='develop'
  fi
}

function create_tag {
  type=$1
  message=$2

  if [[ $# -gt 0 ]]
  then
    type=$1
    shift
  else
    abort "create_tag" "no argument given for type" "NA"
  fi


  if [[ $# -gt 0 ]]
  then
    feature=$1
    shift
  else
    abort "create_tag" "no argument given for feature" "NA"
  fi

  if [[ $# -gt 0 ]]
  then
    message=$1
    shift
  else
    abort "create_tag" "no argument given for message" "NA"
  fi

  case $type in
    "beta")
      if git tag | grep "${type}: ${USER}/${feature}"
      then
        count=$(git tag | grep "${type}-${USER}/${feature}" | wc -l)
        count=$((count + 1))

        TAG="${type}-${USER}/${feature}-${count} ${message}"
      else
        TAG="${type}-${USER}/${feature}-1 ${message}"
      fi
    ;;
    "release")
      # feature is the version in this case 
      TAG="release-${feature} ${message}"
    ;;
    *)
      abort "create_tag" "type: $type is not recognized." "NA"
    ;;
  esac

  echo >/dev/stderr "tag is: $TAG with $message"

  read -p "create tag? [y/n]: " choice

  if [[ $choice == "y" ]]
  then
    git tag -a -m $TAG
  else
    abort "create_tag" "aborted creating tag: $TAG"
  fi
}

#
# vc_options
#

# -v        : verbose
# -d        : dry run

function vc_options {
  args=()

  while [[ $# -gt 0 ]]
  do
    if [[ "$1" == "-v" ]]
    then
      VERBOSE='yes'
      shift
      continue
    fi

    if [[ "$1" == "-d" ]]
    then
      DRY='yes'
      shift
      continue
    fi

    args+=("$1")
    shift
  done

  set -- "${args[@]}"
}

#
# git_options
#

# :custom          = <branch>...?<trunk> or <trunk>...?<branch>
# :upstream        = execute against upstream branch
# :no-merges       = do not show merges
# :only-merges     = only show merges
# :merge           = use ... spec to show changes not in <trunk> and <branch>

# @                = files to operate on, only a single file is legal git.

# DATE             = date format
# COLOR            = yes/no show in color
# SHOW             = flags for output type and format
# VC_ARGS          = remaining arguments from common option processing

#
# return STATUS    = 0 if succesful, 1 if there was an error
#

# 

# pre_options[@]   = this array contains the options that follow
#                    a git command, but before inserted options
#                    and post_options
# post_options[@]  = this array contains the options that are
#                    at the end of a git command.
function git_options {
  merges='false'
  upstream="false"

  spec=""

  type="changes"

  if [[ -n $CUSTOM ]]
  then
    type="custom"
  fi

  while [[ $# -gt 0 ]]
  do
    if [[ "$1" == ":custom" ]]
    then
      type="custom"
      shift

      spec=$1
      shift

      if [[ -z $spec ]]
      then
        abort "git_options" ":custom spec was missing"
      fi

      continue
    fi

    if [[ "$1" == ":upstream" ]]
    then
      upstream='true'
      shift
      continue
    fi

    if [[ "$1" == ":no-merges" ]]
    then
      merge_flags=("--first-parent")
      shift
      continue
    fi

    if [[ "$1" == ":only-merges" ]]
    then
      merging='true'
      merge_flags=("--merges")
      shift
      continue
    fi

    if [[ "$1" == ":merge" ]]
    then
      merging='true'
      shift
      continue
    fi
  done

  if [[ ${#VC_ARGS[@]} -gt 0 ]]
  then
    for f in ${VC_ARGS[@]}
    do
      if [[ ! -f $f ]]
      then
        abort "git_options" "processing unrecognized arguments" "NA" "file \"$f\" does not exist"
      fi
    done
  fi

  case $type in
    "changes")
      if [[ "$upstream" == 'true' ]]
      then
        spec="HEAD..@{upstream}"
      else
        root_to_branch
        spec="${root}..${branch}"
      fi
    ;;
    "merging")
      if [[ "$upstream" == 'true' ]]
      then
        spec="HEAD...@{upstream}"
      else
        root_to_branch
        spec="${root}...${branch}"
      fi
    ;;
    "custom")
      spec=$CUSTOM
    ;;
    *)
      error "git_options" "NA" "log type not specified"
      exit 1
    ;;
  esac


  case $COLOR in
    "yes")
      COLOR="--color"
    ;;
    "no")
      COLOR=""
    ;;
  esac

  OP="log"

  if [[ "$DIFF" == 'yes' ]]
  then
    OP="diff"
  fi

  if [[ "$TOOL" == 'yes' ]]
  then
    OP="difftool"
  fi

  pre_options=($OP $DATE $COLOR $merge_flags)

  post_options=($SHOW $STAT $spec)

  if [[ ${#files[@]} -gt 0 ]]
  then
    post_options+=(${post_options[@]} "--follow" "--" ${files[@]})
  fi

  verbosity "git_options" "generated options" ${pre_options[@]} ${post_options[@]}

  return 0
}

#
# git_arguments - process CLI arguments for git_options
#

# -compact      = show oneline compact form
# -stat         = show diffstat output
# -graph        = show graph of commit history
# -details      = show branch details in log output
# -decorate     = decorate history with branch information
# -color        = color history output
# -no-color     = don't color history output
# -v            = verbose
# -diff         = use a diff operation
# -emacs        = use emacs as a difftool or mergetool
# return

# SHOW          = git flag to specify output type
# STAT          = git 
# DIFF          = yes if showing diff instead of logs
# COLOR         = yes to color output
# VERBOSE       = yes/no to enable verbosity
# CUSTOM        = a custom commit or range specification
function git_arguments {
  VC_ARGS=()

  SHOW=""
  STAT=""
  DIFF="no"
  TOOL="no"
  CUSTOM=""

  while [[ $# -gt 0 ]]
  do
    if [[ "$1" == "-v" ]]
    then
      VERBOSE='yes'
      shift
      continue
    fi

    if [[ "$1" == "-stat" ]]
    then
      STAT="--stat"
      shift
      continue
    fi

    if [[ "$1" == "-color" ]]
    then
      COLOR='yes'
      shift
      continue
    fi

    if [[ "$1" == "-no-color" ]]
    then
      COLOR='no'
      shift
      continue
    fi

    if [[ "$1" == "-diff" ]]
    then
      DIFF='yes'
      shift
      continue
    fi

    if [[ "$1" == "-tool" ]]
    then
      TOOL='yes'
      shift
      continue
    fi

    if [[ "$1" == "-compact" ]]
    then
      SHOW="--oneline"
      shift
      continue
    fi

    if [[ "$1" == "-details" ]]
    then
      SHOW="--pretty=fuller"
      shift
      continue
    fi

    if [[ "$1" == "-graph" ]]
    then
      SHOW="--graph"
      shift
      continue
    fi

    if [[ -z $CUSTOM ]]
    then
      CUSTOM=$1
      shift
      continue
    fi

    VC_ARGS+=$1
    shift
  done
}

#
# semantic_commits
#

# type   = release|main = return commits by "type" against either release->main or main->integration
# filter = semantic tag to filter by

function semantic_commits {
  type="current"

  if [[ -n $1 ]]
  then
    type=$1
  fi

  spec=""

  case $type in
    "release")
      last=`git tag | grep "${RELEASE}" | sort -V | tail -n 1`

      if [[ -z $last ]]
      then
        abort "get_semantic_commits" "no release tags"
      fi

      spec="${last}..${MAIN}"
    ;;
    "integrate")
      spec="${MAIN}..${INTEGRATION}"
    ;;
  esac

  git_arguments -compact -no-color

  if [[ -n $spec ]]
  then
    git_options :no-merges :custom "$spec"
  else
    git_options :no-merges
  fi

  try "git" "semantic_commits" log ${pre_options[@]} ${post_options[@]} | read -r REPORT
}

function get_semantics {
  filter=$1;

  if [[ -n $REPORT ]]
  then
    echo "$REPORT" | cut -d ' ' -f 2-
  fi
}

function print_report {
  if [[ -n $features ]]
  then
    cat <<MESSAGE

* features

$features
MESSAGE
  fi

  if [[ -n $bugs ]]
  then
    cat <<MESSAGE

* bugs

$bugs
MESSAGE
  fi

  if [[ -n $fixes ]]
  then
    cat <<MESSAGE

* fixes

$fixes
MESSAGE
  fi

  if [[ -n $syncs ]]
  then
    cat <<MESSAGE

* syncs

$syncs
MESSAGE
  fi

  if [[ -n $refactor ]]
  then
    cat <<MESSAGE

* refactor

$refactor
MESSAGE
  fi
}

case $1 in
  "tools-zshrc")
    cp "${VCSH_SHELL}/zshrc.rc" $HOME/.zshrc
    verbosity "tools-zshrc" "replaced .zshrc with current version"
    ;;
  "tools-custom")
    cp "${VCSH_SHELL}/zshrc.custom" $HOME/.zshrc.custom
    verbosity "tools-custom" "replaced .zshrc.custom with current version"
    ;;
  "tools-prompt")
    cp "${VCSH_SHELL}/zshrc.prompt" $HOME/.zshrc.prompt
    verbosity "tools-prompt" "replaced prompt with current version"
    ;;

  "tools-brew-init")
    test -d /opt/homebrew || sudo mkdir -p /opt/homebrew
    curl -L https://github.com/Homebrew/brew/tarball/master >/tmp/brew.xz
    sudo tar xJf /tmp/brew.xz --strip 1 -C /opt/homebrew
    sudo chown -R mattie /opt/homebrew
    ;;

  "tools-brew-upgrade")
     $VCSH_ARCH_COMMAND brew update
     $VCSH_ARCH_COMMAND brew upgrade
  ;;
  "tools-brew-install")
    shift

    $VCSH_ARCH_COMMAND brew install $@
  ;;
  "tools-brew-rebuild")
    $VCSH_ARCH_COMMAND brew list | xargs arch -arm64 brew reinstall
  ;;
  "dependencies-init")
    test -d /opt/dependencies || sudo mkdir -p /opt/dependencies
    curl -L https://github.com/Homebrew/brew/tarball/master >/tmp/brew.xz
    sudo tar xJf /tmp/brew.xz --strip 1 -C /opt/dependencies
    sudo chown -R mattie /opt/dependencies
  ;;

  "dependencies-upgrade")
    eval $(${DEP_BREW}bin/brew shellenv)

    $VCSH_ARCH_COMMAND brew update
    $VCSH_ARCH_COMMAND brew upgrade
  ;;

  "dependencies-install")
    shift

    eval $(${DEP_BREW}bin/brew shellenv)
    $VCSH_ARCH_COMMAND brew install $*
  ;;

  #
  # modules
  #
  "modinit")
    git submodule init
    git submodule update --init
    ;;
  "modadd")
    shift

    if [[ -z "$1" || -z "$2" || -z "$3" ]]
    then
      abort "modadd" "submodule command requires <repo> <branch> <local>" "NA"
    fi

    if git submodule add -b $2 $1 $3
    then
      echo "vcsh: add ok. please remember to commit"
    else
      echo "vcsh: add failed. cleanup required."
      exit 1
    fi
    ;;
  "modsync")
    if git pull --recurse-submodules
    then
      echo "vcsh: update ok. please remember to test and commit."
    else
      echo "vcsh: update failed. cleanup required."
      exit 1
    fi
    ;;
  "modupdate")
    shift

    if [[ -z $1 ]]
    then
      echo "vcsh: update a submodule requires a submodule path"
      exit 1
    fi

    if git submodule update --remote $1
    then
      echo "vcsh: update ok. please remember to test and commit."
    else
      echo "vcsh: update failed. cleanup required."
      exit 1
    fi
    ;;
  "modbranch")
    shift

    if [[ -z $1 || -z $2 ]]
    then
      echo "vcsh: update a submodule requires a submodule path and a branch"
      exit 1
    fi

    if (cd $1 && git checkout $2)
    then
      echo "vcsh: switch to branch $2 ok. please remember to commit."
    else
      echo "vcsh: switch submodule $1 to branch $2 failed. cleanup required."
    fi
    ;;
  "modrm")
    shift

    if git rm $1 && git rm -f $1
    then
      if [[ -d $1 ]]
      then
        rm -rf $1
        echo "manual cleanup of source tree $1 done."
      fi

      if [[ -d ".git/modules/$1" ]]
      then
        rm -rf ".git/modules/$1"
        echo "manual cleanup of git module $1 done."
      fi

      echo "vcsh: removal of $1 succeeded."
    else
      echo "vcsh: removal of $1 failed. Repo is in a unknown state"
    fi
    ;;
  "modall")
    echo "all submodule updating..."
    git submodule update --init --recursive || exit 1
    echo "all submodule update done."
    ;;
  #
  # feature branches
  #

  "begin")
    shift

    vc_options $@

    name=$1

    if [[ -z $name ]]
    then
      abort "begin" "name required for a new feature branch" "NA"
    fi

    try git "begin" "checkout the feature branch" checkout -b "${FEATURE}/${name}"

    if [[ $? -ne 0 ]]
    then
      abort "begin" "error creating feature branch $name" "NA"
    fi

    verbosity "begin" "new feature branch \"$name\""
   ;;
  "end")
    shift

    vc_options $@

    name=$1

    if [[ -z $name ]]
    then
      abort "end" "get name of branch" "NA"
    fi

    if ! git branch | grep "${FEATURE}/${name}" >/dev/null 2>&1
    then
      abort "end" "feature branch ${name} not found" "NA"
    fi

    try git "end" "checkout trunk" checkout "${INTEGRATION}"

    checkout_status=$?

    if $[[ $checkout_status -gt 0 ]]
    then
      abort "end" "error switching to ${INTEGRATION} branch for merging ${name}" $checkout_status
    fi
    ;;
  "bug")
    shift
    name=$1

    if [[ -z $name ]]
    then
      echo "vcsh bug: requires a name for a new bug branch as an argument"
      exit 1
    fi

    git flow bugfix start "$name"
    ;;
  "close")
    shift
    name=$1

    if [[ -z $name ]]
    then
      echo "vcsh close: requires the name of the bugfix branch to close"
      exit 1
    fi

    git flow bugfix finish $name
    ;;
  "goto")
    shift
    
    vc_options $@

    name=$1

    if [[ -z $name ]]
    then
      abort "goto" "name of the bug or feature branch required" "NA"
    fi

    if [[ "$name" == "$INTEGRATON" || "$name" == "$MAIN" ]]
    then
      exec git checkout "$name"
    fi

    if git branch | grep "${FEATURE}/$name" >/dev/null 2>&1
    then
      verbosity "checking out feature: $name"
      exec git checkout "feature/${name}"
    fi

    if git branch bugfix | grep "$name" >/dev/null 2>&1
    then
      verbosity "checking out bugfix: $name"
      exec git checkout "bugfix/${name}"
    fi

    abort "\"$name\" not found in features or bugfixes"
    ;;    
  "beta")
    shift

    message=$1

    if [[ -z $message ]]
    then
      abort "beta - message argument is missing."
    fi

    create_tag "beta" "$FEATURE" "$MESSAGE"
    ;;
  "track")
    shift

    REMOTE=$1

    if [[ -z $REMOTE ]]
    then
      echo >/dev/stderr "vcsh: track - a remote (1) is missing"
      exit 1
    fi

    BRANCH=$2

    if [[ -z $BRANCH ]]
    then
      echo >/dev/stderr "vcsh track - a branch (2) is missing."
      exit 1
    fi

    git branch -u $REMOTE/$BRANCH
    ;;
  "report")
    shift

    type=""

    while [[ $# -gt 0 ]]
    do
      if [[ $1 == "-v" ]]
      then
        VERBOSE="yes"
        shift
        continue
      fi

      if [[ $1 == "-main" ]]
      then
        type="release"
        shift
        continue
      fi

      if [[ $1 == "-dev" ]]
      then
        type="integrate"
        shift
        continue
      fi

      abort "report" "unrecognized option: $1" "NA"
      shift
    done

    semantic_commits $type

#    features=`get_semantics feat`
#    bugs=`get_semantics bug`
#    issues=`get_semantics issue`
#    syncs=`get_semantics sync`
#    fixes=`get_semantics fix`
#    refactor=`get_semantics refactor`

    print_report
    ;;
  "status")
    shift

    vc_options $@

    color=""

    if [[ $1 == "-color" || "$COLOR" == "yes" ]]
    then
      color="--color"
    fi

    try_no_blanks git "status:branches" "running git banch" branch -vv $color

    try_no_blanks git "status:status" "running git status" status

    echo "[untracked]"
    try git "status:untracked" "executing ls-files to show untracked" ls-files --others --exclude-standard

    echo "[staged]"
    try_no_blanks git "status:staged" "diff staged" diff --staged --stat $color

    echo "[changes]"
    try_no_blanks git "status:changes" "basic diff" diff --stat $color
    ;;
  "verify")
    exec git log --show-signature $@
    ;;
  "show")
      shift

      vc_options $@

      if [[ $# -lt 1 ]]
      then
        git_options
        try "git" "show" "attempting to get last commit (no arg)" "show"
        exit $?
      fi

      if [[ $1 == "-l" ]]
      then 
        git_arguments -compact -no-color
        git_options

        try git "show" "a numbered list list of commits" ${pre_options[@]} ${post_options[@]} | nl
        exit $?
      fi

      if [[ $1 == "-n" ]]
      then
        shift
        number=$1

        verbosity "show" "commit number is: ${number}"

        git_arguments -compact -no-color
        git_options

        commit=`try git "show" "show a numbered commit" ${pre_options[@]} ${post_options[@]} | sed -n -e "${number}p" | tr -s ' ' | cut -d ' ' -f 1`

        verbosity "show" "found commit id" $commit
      fi
     ;;
  "fetch")
    try_no_blanks "git" "git fetch" fetch
    ;;
  "pull")
    git pull --no-ff
    ;;
  "patch")
    shift

    vc_options $@

    git_options

    try git "patch" "diff --cached generate patch" diff -p --no-color | sed -e 's,^--- [ab]/,--- ,' | sed -e 's,^+++ [ab]/,+++ ,'
    ;;
  "pending")
    shift

    git_arguments $@

    git_options :merge

    try_no_blanks "git" "pending" "show work not in root" ${pre_options[@]} ${post_options[@]}
    exit $?
    ;;
  "list")
    shift

    case $1 in
      "merges")
        git_options ":only-merges" $@
        try_no_blanks "git" "merges" "log of merges only" ${pre_options[@]} ${post_options[@]}
      ;;
      "releases")
        git tag | grep release | sort -V | grep -v -E '^$'
      ;;

      "bugfixes")
        git branch | grep "${BUGFIX}"
      ;;    
      "features")
        git branch | grep "${FEATURE}"
      ;;
      *)
        abort "list" "list type argument missing" "NA"
      ;;
    esac
    ;;
  "history")
    shift

    vc_options $@

    git_arguments $@

    git_options

    try_no_blanks "git" "history" "show commits on current branch" ${pre_options[@]} ${post_options[@]}
    ;;
  "ahead")
    shift

    git_arguments $@

    git_options $@

    try_no_blanks "git" "ahead" 'show commits in branch, not trunk' ${pre_options[@]} ${post_options[@]}
    ;;
  "behind")
    shift

    git_arguments $@

    root_to_branch norelease

    git_options

    try_no_blanks "git" "behind" "show commits on trunk not in branch" ${pre_options[@]} ${post_options[@]}
    ;;
  "up")
    git push origin "${MAIN}:${MAIN}"
    git push origin "${INTEGRATION}:${INTEGRATION}"

    git push --tags
    ;;
  "down")
    shift

    git fetch origin ${MAIN}
    git fetch origin ${INTEGRATION}

    git_arguments $@
    git_options :upstream

    try_no_blanks "git" "down" "fetch and show commits upstream not local" ${pre_options[@]} ${post_options[@]}
    ;;
  "merge")
    shift

    vc_options $@

    root_to_branch norelease

    verbosity "merging: ${branch} into ${root}"

    try "git" "checkout the root: ${root} for merge" checkout ${root}
    try "git" "merge no ff from: ${branch}" merge --no-ff ${branch}
    ;;

  #
  # release environment
  #

  "check")
    verbosity "check" "fetching new commits from remote"
    git fetch origin develop

    echo "===> showing unmerged differences <===="

    verbosity "check" "showing unmerged differences"

    git log develop..origin/develop --oneline

    echo "===> checking if working tree is dirty <==="

    if git diff --quiet >/dev/null 2>&1
    then
      echo "working tree clean - proceed!"
    else
      echo "working tree dirty - DO NOT RELEASE"

      git status
      exit 1
    fi
    ;;
  "start")
    shift

    $0 check

    echo "EDITOR is: $EDITOR ... correct?"

    read -p "Proceed? [y/n]: " proceed

    if [[ $proceed = "y" ]]
    then
      echo ">>> proceeding with release start!"
    else
      echo ">>> ABORT! exiting now!"
      exit 1
    fi

    VERSION="$1"

    echo -n "initiating git flow release start with version: $VERSION"

    git flow release start $VERSION

    if [[ $? -ne 0 ]]
    then
      echo "git flow release start $VERSION FAILED!"
      exit 1
    fi

    echo -n ">>>please edit python.sh with an updated version in 3 seconds."
    sleep 1
    echo -n "."
    sleep 1
    echo -n "."
    sleep 1

    $EDITOR python.sh || exit 1
    git add python.sh

    echo ">>>re-loading vc.sh"
    source vc.sh

    echo ">>>commit with release notes for version $VERSION"

    # don't do a automatic commit so a release summary can be inserted
    git commit

    echo "ready for release finish: please finish with vc release once you are ready"
    ;;
  "release")
    git flow release finish $VERSION || exit 1
    ;;
  "upload")
    git push origin main:main
    git push origin develop:develop

    git push --tags
    ;;
  "help")
    if [[ -n $2 ]]
    then
      filter="$2"
    else
      filter='\.*'
    fi

    echo "filter is $filter"

    cat <<HELP | grep "$filter"
vc

[tools commands]

tools-zshrc         = install hombrew, pyenv, and pyenv switching commands into .zshrc
tools-custom        = install zshrc.custom
tools-prompt        = install prompt support with pyeenv, git, and project in the prompt

brew-upgrade        = upgrade brew packages

tools-brew-init     = initialize the /opt/homebrew homebrew repository
tools-brew-upgrade  = upgrade the /opt/homebrew repository
tools-brew-install  = install into /opt/homebrew a list of packages
tools-brew-rebuild  = rebuild packages in /opt/homebrew

dependencies-init     = initialize /opt/dependencies for stable and minimal deps to compile against
dependencies-upgrade  = upgrade /opt/dependencies 
dependencies-install  = install into /opt/dependencies a list of packages
dependencies-python   = install into /opt/dependencies python dependencies

[submodule]

modinit             = initialize and pull all submodules
modadd <1> <2> <3>  = add a submodule where 1=repo 2=branch 3=localDir (commit after)
modupdate <module>  = pull the latest version of the module
modsync             = pull and sync all modules to checked out commits
modrm  <submodule>  = delete a submodule
modall              = update all submodules

[version control]

track <1> <2> = set upstream tracking 1=remote 2=branch

[workflow]

begin <name>  = start feature branch
end <name>    = close feature branch <name>

bug           = start a bug branch
close         = finish a bugfix merging into develop

goto          = switch to feature or bugfix branch, searches branches

beta <msg>    = create a beta tag with the message

verify   = show log with signatures for verification
status   = git state, submodule state, diffstat for changes in tree
fetch    = fetch main, develop, and current branch
pull     = pull current branch no ff

[show log/diff/reports]

patch      = generate a unified diff

list       = <merges|releases|features>

history    = show commit history
pending    = commits not in root or branch
ahead      = show log of commits in branch but not in parent
behind     = show log of commit in parent but not branch

report     = [-release] = generate a report of changes since integration

up         = push up trunk changes to remote
down       = pull down trunk and local changes

sync       = merge from the root branch commits not in this branch no ff

[release]

check      = fetch main, develop from origin and show log of any pending changes
start      = initiate an EDITOR session to update VERSION in python.sh, reload config,
             snapshot Pipfile if present, and start a git flow release with VERSION

             for the first time pass version as an argument e.g: "vc start 1.0.0"

release    = execute git flow release finish with VERSION
upload     = push main and develop branches and tags to remote
HELP
  ;;
  *)
    $0 history $@
  ;;
esac

exit 0
